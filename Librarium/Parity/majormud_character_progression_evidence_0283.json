  "formulas": {
    "experience": {
      "chart": "(class.ExperienceStored + 100) + race.ExperienceAddPercent",
      "level_1": 0,
      "level_2": "chart * 10",
      "level_modifiers": {
        "3": "40/20",
        "4-5": "44/24",
        "6-7": "48/28",
        "8-9": "52/32",
        "10-11": "56/36",
        "12-13": "60/40",
        "14-15": "65/45",
        "16-17": "70/50",
        "18": "75/55",
        "19-26": "50/40",
        "27": "23/20",
        "28-55": "115/100",
        "56-58": "109/100",
        "59+": "108/100"
      },
      "overflow": "Preserve recovered unsigned-32-bit rollover and billions-tabulation semantics.",
      "classification": "STRONG"
    },
    "character_points": {
      "promotion_award": "((targetLevel - 1) div 10) * 5 + 10, for targetLevel >= 2",
      "classification": "STRONG"
    },
    "picklocks": {
      "grant_ability": 37,
      "bonus_ability": 180,
      "level_component": "level <= 15 ? level*2 : ((((level-15) div 2)+15)*2)",
      "base": "(((levelComponent*5)+(AGL+INT))*2) div 7",
      "classification": "STRONG",
      "branch_boundary": "The CHA-bearing competing formula is GreaterMUD-only and is not used in Classic."
    },
    "lives": {
      "maximum": 9,
      "death_cost": 1,
      "level_up_gain": 1,
      "level_up_cap": 9,
      "zero_lives": "permanent death / no respawn",
      "classification": "mixed PASS/STRONG according to existing ledger evidence policy"
    }
