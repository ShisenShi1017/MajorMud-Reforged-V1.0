{
  "schemaVersion": 1,
  "subsystem": "events",
  "runtimeOwner": "RuntimeWorldEventService",
  "status": "runtime-active-partially-exhausted",
  "eventFamilies": [
    "timed", "recurring", "holiday", "sysop-triggered", "quest", "spawn", "invasion", "boss", "treasure", "world-state", "textblock", "script", "remote-action"
  ],
  "lifecycle": [
    "inactive", "scheduled", "active", "completed", "cancelled", "failed"
  ],
  "actionKinds": [
    "trigger", "script", "spawn", "despawn", "reward", "world-state", "announcement", "cleanup"
  ],
  "deterministicOrdering": [
    "explicit action order", "canonical action id tie-break"
  ],
  "integrations": {
    "clockScheduling": "supplies due-time activation requests",
    "triggersScripts": "own execution semantics",
    "npcAi": "owns spawn and despawn execution",
