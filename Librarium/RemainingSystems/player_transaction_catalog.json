  "nativeDependencies": [
    "exact Classic give/trade/auction command families",
    "native escrow and atomicity",
    "capacity and weight validation ordering",
    "limited and quest item restrictions",
    "disconnect rollback",
    "auction/bid/buyout persistence",
    "exact messages and logging"
  ]
}
