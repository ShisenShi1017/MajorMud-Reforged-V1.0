{
  "schemaVersion": 1,
  "subsystem": "player-transactions",
  "runtimeOwner": "RuntimePlayerTransactionService",
  "persistenceOwner": "transaction coordinator; Character inventory and Economy own assets and balances",
  "operations": [
    "offer",
    "accept",
    "commit",
    "cancel",
    "disconnect cancellation"
  ],
  "policies": [
    "revision conflict rejection",
    "quest/limited/bound item restrictions",
    "positive quantities",
    "offer expiration",
    "two-party authorization"
  ],
  "typedRequests": [
    "CharacterInventory reserve-transfer",
    "Economy reserve-transfer"
  ],
  "safeFallback": "Reject unknown parties, restricted assets, stale revisions, expired offers, and unauthorized acceptance.",
