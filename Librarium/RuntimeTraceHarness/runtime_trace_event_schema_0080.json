{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RealmGate Runtime Trace Event Schema 0080",
  "type": "object",
  "required": ["schema_version", "probe_id", "event", "timestamp_utc", "source", "sequence"],
  "properties": {
    "schema_version": {"const": "0080.1"},
    "probe_id": {"type": "string"},
    "event": {"type": "string"},
    "timestamp_utc": {"type": "string", "description": "ISO-8601 UTC timestamp, generated by instrumentation."},
    "monotonic_ms": {"type": "number", "description": "Monotonic milliseconds from trace start when available."},
    "sequence": {"type": "integer", "minimum": 0},
    "source": {"type": "string", "enum": ["MBBSEmu", "MajorMUD", "Reforged", "Simulator", "Harness"]},
    "module": {"type": "string"},
    "channel": {"type": ["integer", "null"]},
    "routine": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"], "enum": ["enter", "exit", "queue", "drain", "flush", "observe", "error", null]},
    "payload": {"type": "object"},
    "evidence_state": {"type": "string", "enum": ["Observed", "Derived", "Hypothesis"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
