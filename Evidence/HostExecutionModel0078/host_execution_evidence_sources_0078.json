  {
    "id": "mbbsemu_begin_polling",
    "source": "MBBSEmu GitHub ZIP",
    "path": "HostProcess/ExportedModules/Majorbbs.cs",
    "sha256": "3bcaa8ee7abf875fd09d727f7161ecf169ab98330032c1847d7651e4c38cb3c8",
    "line_start": 4882,
    "line_end": 4925,
    "summary": "BEGIN_POLLING exported API: per-channel routine called as fast/often as possible until STOP_POLLING.",
    "excerpt": [
      {
        "line": 4882,
        "text": "        ///     Turn on polling for the specified user number channel"
      },
      {
        "line": 4883,
        "text": "        ///"
      },
      {
        "line": 4884,
        "text": "        ///     This will be called as fast as possible, as often as possible until"
      },
      {
        "line": 4885,
        "text": "        ///     stop_polling() is called"
      },
      {
        "line": 4886,
        "text": "        ///"
      },
