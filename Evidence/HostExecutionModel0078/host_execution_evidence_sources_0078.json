        "line": 392,
        "text": "                            }"
      },
      {
        "line": 393,
        "text": ""
      },
      {
        "line": 394,
        "text": "                        //User is in the module, process all the in-module type of events"
      },
      {
        "line": 395,
        "text": "                        case EnumSessionState.InModule:"
      },
      {
        "line": 396,
        "text": "                            {"
      },
      {
        "line": 397,
        "text": "                                //Did BTUCHI or a previous command cause a status change?"
      },
      {
        "line": 398,
        "text": "                                if (session.GetStatus() == EnumUserStatus.CYCLE || session.GetStatus() == EnumUserStatus.OUTPUT_BUFFER_EMPTY)"
      },
      {
