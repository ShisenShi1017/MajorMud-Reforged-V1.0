      },
      {
        "line": 419,
        "text": "                            }"
      },
      {
        "line": 420,
        "text": ""
      },
      {
        "line": 421,
        "text": "                        //Check for any other session states, we handle these here as they are"
      },
      {
        "line": 422,
        "text": "                        //lower priority than handling \"in-module\" states"
      },
      {
        "line": 423,
        "text": "                        default:"
      },
