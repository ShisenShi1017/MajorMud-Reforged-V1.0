  {
    "id": "mbbsemu_host_routines",
    "source": "MBBSEmu GitHub ZIP",
    "path": "HostProcess/MbbsHost.cs",
    "sha256": "d67f9a2eb7bf90a2cfd2564689f62f3a085f839285150e1210dbe21be89ee705",
    "line_start": 725,
    "line_end": 840,
    "summary": "Host routine dispatch: STSROU, BEGIN_POLLING routine, RTKICK, RTIHDLR, SYSCYC, INITASK.",
    "excerpt": [
      {
        "line": 725,
        "text": "        ///     Invokes routine registered as STSROU during MAJORBBS->REGISTER_MODULE() call"
      },
      {
        "line": 726,
        "text": "        ///"
      },
      {
        "line": 727,
        "text": "        ///     The registered STSROU is invoked any time there is a status change or deferred processing"
      },
      {
        "line": 728,
        "text": "        ///     using a channel Status code of 240 or 5. Most modules that utilize this use it as a method to"
      },
      {
        "line": 729,
        "text": "        ///     rapidly call the module to perform actions at a calculated interval"
      },
      {
        "line": 730,
        "text": "        /// </summary>"
      },
      {
        "line": 731,
        "text": "        /// <param name=\"session\"></param>"
      },
      {
        "line": 732,
        "text": "        [MethodImpl(MethodImplOptions.AggressiveInlining)]"
      },
      {
        "line": 733,
        "text": "        private void ProcessSTSROU(SessionBase session)"
      },
      {
        "line": 734,
        "text": "        {"
      },
      {
        "line": 735,
        "text": "            Run(session.CurrentModule.ModuleIdentifier, session.CurrentModule.MainModuleDll.EntryPoints[\"stsrou\"],"
      },
      {
        "line": 736,
        "text": "                session.Channel);"
      },
      {
        "line": 737,
        "text": "        }"
      },
      {
        "line": 738,
        "text": ""
      },
      {
        "line": 739,
        "text": "        /// <summary>"
      },
      {
        "line": 740,
        "text": "        ///     Invokes routine registered during MAJORBBS->BEGIN_POLLING()"
      },
      {
        "line": 741,
        "text": "        ///"
      },
      {
        "line": 742,
        "text": "        ///     Method registered using BEGIN_POLLING() is called as often as possible to poll for a specific event"
      },
      {
        "line": 743,
        "text": "        ///     and will not stop polling until STOP_POLLING() is invoked"
      },
      {
        "line": 744,
        "text": "        /// </summary>"
      },
      {
        "line": 745,
        "text": "        /// <param name=\"session\"></param>"
      },
      {
        "line": 746,
        "text": "        [MethodImpl(MethodImplOptions.AggressiveInlining)]"
      },
      {
        "line": 747,
        "text": "        private void ProcessPollingRoutine(SessionBase session)"
      },
      {
        "line": 748,
        "text": "        {"
      },
      {
        "line": 749,
        "text": "            Run(session.CurrentModule.ModuleIdentifier, session.PollingRoutine, session.Channel,"
      },
      {
        "line": 750,
        "text": "                true);"
      },
      {
        "line": 751,
        "text": "        }"
      },
      {
        "line": 752,
        "text": "        /// <summary>"
      },
      {
        "line": 753,
        "text": "        ///     Invokes routine registered during MAJORBBS->RTKICK()"
      },
      {
        "line": 754,
        "text": "        ///"
      },
      {
        "line": 755,
        "text": "        ///     Methods registered using RTKICK are automatically invoked after a specified delay (in seconds). Methods"
      },
      {
        "line": 756,
        "text": "        ///     only execute once and are then discarded."
      },
      {
        "line": 757,
        "text": "        /// </summary>"
      },
      {
        "line": 758,
        "text": "        [MethodImpl(MethodImplOptions.AggressiveInlining)]"
      },
      {
        "line": 759,
        "text": "        private void ProcessRTKICK()"
      },
      {
        "line": 760,
        "text": "        {"
      },
      {
        "line": 761,
        "text": "            //Check for any rtkick routines"
      },
      {
        "line": 762,
        "text": "            foreach (var module in _modules.Values.Where(m => (bool)m.ModuleConfig.ModuleEnabled))"
      },
      {
        "line": 763,
        "text": "            {"
      },
      {
        "line": 764,
        "text": "                if (module.RtkickRoutines.Count == 0) continue;"
      },
      {
        "line": 765,
        "text": ""
      },
      {
        "line": 766,
        "text": "                foreach (var (key, value) in module.RtkickRoutines.ToList())"
      },
      {
        "line": 767,
        "text": "                {"
      },
      {
        "line": 768,
        "text": "                    if (!value.Executed && value.Elapsed.ElapsedMilliseconds > value.Delay * 1000)"
      },
      {
        "line": 769,
        "text": "                    {"
      },
      {
        "line": 770,
        "text": "#if DEBUG"
      },
      {
        "line": 771,
        "text": "                        Logger.Info($\"Running RTKICK-{key}: {value}\");"
      },
      {
        "line": 772,
        "text": "#endif"
      },
      {
        "line": 773,
        "text": "                        Run(module.ModuleIdentifier, value, ushort.MaxValue);"
      },
      {
        "line": 774,
        "text": ""
      },
      {
        "line": 775,
        "text": "                        value.Elapsed.Stop();"
      },
      {
        "line": 776,
        "text": "                        value.Executed = true;"
      },
      {
        "line": 777,
        "text": "                        module.RtkickRoutines.Remove(key);"
      },
      {
        "line": 778,
        "text": "                    }"
      },
      {
        "line": 779,
        "text": "                }"
      },
      {
        "line": 780,
        "text": "            }"
      },
      {
        "line": 781,
        "text": "        }"
      },
      {
        "line": 782,
        "text": ""
      },
      {
        "line": 783,
        "text": "        /// <summary>"
      },
      {
        "line": 784,
        "text": "        ///     Invokes routine registered during MAJORBBS->RTIHDLR()"
      },
      {
        "line": 785,
        "text": "        ///"
      },
      {
        "line": 786,
        "text": "        ///     Methods registered with RTIHDLR execute at 18hz (every ~55ms) and on the original DOS MajorBBS/Worldgroup"
      },
      {
        "line": 787,
        "text": "        ///     were executed at the DOS interrupt level. This is why on later Windows versions of worldgroup, any Module"
      },
      {
        "line": 788,
        "text": "        ///     that relied on RTIHDLR wouldn't work."
      },
      {
        "line": 789,
        "text": "        ///"
      },
      {
        "line": 790,
        "text": "        ///     Unlike RTKICK, methods registered with RTIHDLR() only need to be registered once and will run until the BBS"
      },
      {
        "line": 791,
        "text": "        ///     is shut down."
      },
      {
        "line": 792,
        "text": "        /// </summary>"
      },
      {
        "line": 793,
        "text": "        [MethodImpl(MethodImplOptions.AggressiveInlining)]"
      },
      {
        "line": 794,
        "text": "        private void ProcessRTIHDLR()"
      },
      {
        "line": 795,
        "text": "        {"
      },
      {
        "line": 796,
        "text": "            //Too soon? Bail."
      },
      {
        "line": 797,
        "text": "            if (_realTimeStopwatch.ElapsedMilliseconds <= 55) return;"
      },
      {
        "line": 798,
        "text": ""
      },
      {
        "line": 799,
        "text": "            foreach (var m in _modules.Values.Where(m => (bool)m.ModuleConfig.ModuleEnabled))"
      },
      {
        "line": 800,
        "text": "            {"
      },
      {
        "line": 801,
        "text": "                if (m.RtihdlrRoutines.Count == 0) continue;"
      },
      {
        "line": 802,
        "text": ""
      },
      {
        "line": 803,
        "text": "                foreach (var r in m.RtihdlrRoutines)"
      },
      {
        "line": 804,
        "text": "                {"
      },
      {
        "line": 805,
        "text": "                    Run(m.ModuleIdentifier, r.Value, ushort.MaxValue);"
      },
      {
        "line": 806,
        "text": "                }"
      },
      {
        "line": 807,
        "text": "            }"
      },
      {
        "line": 808,
        "text": ""
      },
      {
        "line": 809,
        "text": "            _realTimeStopwatch.Restart();"
      },
      {
        "line": 810,
        "text": "        }"
      },
      {
        "line": 811,
        "text": ""
      },
      {
        "line": 812,
        "text": "        /// <summary>"
      },
      {
        "line": 813,
        "text": "        ///     Processes the routine set to a modules specified SYSCYC Pointer"
      },
      {
        "line": 814,
        "text": "        /// </summary>"
      },
      {
        "line": 815,
        "text": "        private void ProcessSYSCYC()"
      },
      {
        "line": 816,
        "text": "        {"
      },
      {
        "line": 817,
        "text": "            foreach (var m in _modules.Values.Where(m => (bool)m.ModuleConfig.ModuleEnabled))"
      },
      {
        "line": 818,
        "text": "            {"
      },
      {
        "line": 819,
        "text": "                var syscycPointer = m.Memory.GetPointer(m.Memory.GetVariablePointer(\"SYSCYC\"));"
      },
      {
        "line": 820,
        "text": "                if (syscycPointer == FarPtr.Empty) continue;"
      },
      {
        "line": 821,
        "text": ""
      },
      {
        "line": 822,
        "text": "                Run(m.ModuleIdentifier, syscycPointer, ushort.MaxValue);"
      },
      {
        "line": 823,
        "text": "            }"
      },
      {
        "line": 824,
        "text": "        }"
      },
      {
        "line": 825,
        "text": ""
      },
      {
        "line": 826,
        "text": "        /// <summary>"
      },
      {
        "line": 827,
        "text": "        ///     Invokes routine registered during MAJORBBS->INITASK()"
      },
      {
        "line": 828,
        "text": "        ///"
      },
      {
        "line": 829,
        "text": "        ///     Similar to BEGIN_POLLING() or RTIHDLR(), methods registered with INITASK() are invoked very quickly as often"
      },
      {
        "line": 830,
