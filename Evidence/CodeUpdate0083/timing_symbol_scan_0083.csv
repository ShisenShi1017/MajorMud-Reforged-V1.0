mmud_explorer,modMain.bas,4350,regen,"Public Function CalcRoundsToOOM(ByVal ManaCost As Double, ByVal MaxMana As Long, ByVal RegenRate As Double, _"
mmud_explorer,modMain.bas,4355,regen,"Dim RoundsPerRegen As Long, regenBetween As Long, nRoundsDuration As Integer, nDurationRounds As Long"
mmud_explorer,modMain.bas,4360,round_secs;combat round,Const RoundSecs     As Long = ROUND_SECS   ' combat round length (5 sec)
mmud_explorer,modMain.bas,4361,regen,Const regenSecs     As Long = 30           ' mana regen interval
mmud_explorer,modMain.bas,4362,round_secs;spell_round_secs,Const SpellRoundSecs As Long = SPELL_ROUND_SECS  ' spell aura tick length (3 sec)
mmud_explorer,modMain.bas,4364,regen;combat round,RoundsPerRegen = regenSecs \ RoundSecs     ' e.g. 30 \ 5 = 6 combat rounds per regen
mmud_explorer,modMain.bas,4371,round_secs;spell_round_secs,    '===== Aura spell: nDuration is in SPELL_ROUND_SECS (3-sec) ticks =====
mmud_explorer,modMain.bas,4373,regen,    Dim regenTicks As Long
mmud_explorer,modMain.bas,4378,regen,    ' How many full mana-regen ticks occur during one full aura duration
mmud_explorer,modMain.bas,4379,regen,    regenTicks = auraSecs \ regenSecs       ' e.g. 90 \ 30 = 3
mmud_explorer,modMain.bas,4381,regen,    ' Total mana regenerated between full aura casts
mmud_explorer,modMain.bas,4382,regen,    regenBetween = regenTicks * RegenRate
mmud_explorer,modMain.bas,4386,regen,    If regenBetween >= (ManaCost + ((ManaCost / 2) * (1 - (nCastChance / 100)))) Then
mmud_explorer,modMain.bas,4390,combat round,    ' Convert aura duration (in 3-sec ticks) into equivalent combat rounds (5-sec)
mmud_explorer,modMain.bas,4395,combat round,"    ' Instant / non-aura spell, cast on the 5-second combat round"
mmud_explorer,modMain.bas,4396,regen,    If RegenRate >= (ManaCost * RoundsPerRegen) Then Exit Function  'never oom
mmud_explorer,modMain.bas,4410,combat round,        ' Non-aura: cast every 5-second combat round
mmud_explorer,modMain.bas,4414,combat round,        ' First aura cast happens at the first combat round
mmud_explorer,modMain.bas,4441,regen,    '===== Mana regen on its 30-second schedule =====
mmud_explorer,modMain.bas,4442,regen,    If (rounds Mod RoundsPerRegen) = 0 Then
mmud_explorer,modMain.bas,4443,regen,        CurrentMana = CurrentMana + RegenRate
