mmud_explorer,modExpPerHour.bas,20,regen,Public Const SEC_PER_REGEN_TICK As Double = 30#
mmud_explorer,modExpPerHour.bas,101,1.5,Private Const cephD_KILL_OVERHEAD_SEC As Double = 1.5   'looting/retarget/latency seconds per kill (overlaps recovery)
mmud_explorer,modExpPerHour.bas,114,per round,    PerMobDmgPerRound   As Double   'Incoming damage per round per mob
mmud_explorer,modExpPerHour.bas,213,regen,'   - Uses nMobHPRegen when fights are long (approx RTK >= 6).
mmud_explorer,modExpPerHour.bas,227,regen,            ByVal nMobHPRegen As Long) As tCephC_CombatProfile
mmud_explorer,modExpPerHour.bas,247,regen,    Dim approxRTKNoRegen    As Double
mmud_explorer,modExpPerHour.bas,248,regen,    Dim perMobRegenTick     As Double
mmud_explorer,modExpPerHour.bas,249,regen,    Dim regenPerRound       As Double
mmud_explorer,modExpPerHour.bas,282,regen,    ' Approximate RTK ignoring regen to decide whether to include nMobHPRegen
mmud_explorer,modExpPerHour.bas,284,regen,        approxRTKNoRegen = mobHP / avgDmgNorm
mmud_explorer,modExpPerHour.bas,286,regen,        approxRTKNoRegen = 0#
mmud_explorer,modExpPerHour.bas,291,regen,    If (nMobHPRegen > 0) And (approxRTKNoRegen >= 6#) Then
mmud_explorer,modExpPerHour.bas,292,regen;per round,        'Per-mob HP regen per tick and per round
mmud_explorer,modExpPerHour.bas,293,regen,        perMobRegenTick = CDbl(nMobHPRegen) / nNumMobs
mmud_explorer,modExpPerHour.bas,294,regen,        If SEC_PER_REGEN_TICK > 0# Then
mmud_explorer,modExpPerHour.bas,295,regen,            'regenPerRound = perMobRegenTick * (SEC_PER_ROUND / SEC_PER_REGEN_TICK)
mmud_explorer,modExpPerHour.bas,297,regen,                regenPerRound = perMobRegenTick * (SEC_PER_ROUND / (GMUD_MOB_HPREGEN_ROUNDS * SEC_PER_ROUND))
mmud_explorer,modExpPerHour.bas,299,regen,                regenPerRound = perMobRegenTick * (SEC_PER_ROUND / (STOCK_MOB_HPREGEN_ROUNDS * SEC_PER_ROUND))
mmud_explorer,modExpPerHour.bas,302,regen,            regenPerRound = 0#
mmud_explorer,modExpPerHour.bas,305,regen,        avgDmgForSeq = avgDmgNorm - regenPerRound
mmud_explorer,modExpPerHour.bas,307,regen,        'Clamp so regen cannot completely erase our DPS in the model
mmud_explorer,modExpPerHour.bas,449,regen,"                         ""; MobHPRegen="" & CStr(nMobHPRegen)"
mmud_explorer,modExpPerHour.bas,464,regen,'   nTotalLairs <= 0 AND nRegenTime > 0
mmud_explorer,modExpPerHour.bas,468,regen,'   nTotalLairs < 0 AND nRegenTime = 0
mmud_explorer,modExpPerHour.bas,473,regen,"            ByVal nRegenTime As Double, _"
mmud_explorer,modExpPerHour.bas,480,regen,"            ByVal nCharHPRegen As Long, _"
mmud_explorer,modExpPerHour.bas,482,regen,"            ByVal nCharMPRegen As Long, _"
mmud_explorer,modExpPerHour.bas,489,regen,"            ByVal nMobHPRegen As Long, _"
mmud_explorer,modExpPerHour.bas,532,regen,    Dim hpRegenPerSecRest       As Double
mmud_explorer,modExpPerHour.bas,533,regen,    Dim mpRegenPerSecRest       As Double
mmud_explorer,modExpPerHour.bas,537,regen,    Dim regenSecs               As Double
mmud_explorer,modExpPerHour.bas,552,regen,    If (nTotalLairs <= 0) And (nRegenTime > 0#) Then
mmud_explorer,modExpPerHour.bas,553,regen,        ' nRegenTime here is HOURS between boss kills
mmud_explorer,modExpPerHour.bas,554,36;regen,        regenSecs = nRegenTime * 3600#
mmud_explorer,modExpPerHour.bas,555,regen,        If regenSecs < attackSecsPerLair Then regenSecs = attackSecsPerLair
mmud_explorer,modExpPerHour.bas,562,regen,        c.roamSecs = regenSecs - attackSecsPerLair
mmud_explorer,modExpPerHour.bas,564,regen,        c.cycleSecs = regenSecs
mmud_explorer,modExpPerHour.bas,584,regen,    If (nTotalLairs < 0) And (nRegenTime = 0#) Then
mmud_explorer,modExpPerHour.bas,594,regen,    ' HP regen rates (per second)
mmud_explorer,modExpPerHour.bas,595,regen,    '   - Natural: (nCharHPRegen / 3) per SEC_PER_REGEN_TICK (always)
mmud_explorer,modExpPerHour.bas,596,regen,    '   - Rest extra: nCharHPRegen per SEC_PER_REST_TICK while RESTING
mmud_explorer,modExpPerHour.bas,599,regen,    If SEC_PER_REGEN_TICK > 0# Then
mmud_explorer,modExpPerHour.bas,600,regen,        hpNatPerSec = (CDbl(nCharHPRegen) / 3#) / SEC_PER_REGEN_TICK
mmud_explorer,modExpPerHour.bas,605,regen,        hpRestExtraPerSec = CDbl(nCharHPRegen) / SEC_PER_REST_TICK
mmud_explorer,modExpPerHour.bas,609,regen,    ' MP regen rates (per second)
mmud_explorer,modExpPerHour.bas,610,regen,    '   - Natural: nCharMPRegen per SEC_PER_REGEN_TICK (always)
mmud_explorer,modExpPerHour.bas,614,regen,    If SEC_PER_REGEN_TICK > 0# Then
mmud_explorer,modExpPerHour.bas,615,regen,        mpNatPerSec = CDbl(nCharMPRegen) / SEC_PER_REGEN_TICK
mmud_explorer,modExpPerHour.bas,644,regen,        ' Zero out all HP/MP drain and regen so no rest is ever required
mmud_explorer,modExpPerHour.bas,705,regen,"    '       move ? fight, applying natural regen during both."
mmud_explorer,modExpPerHour.bas,771,regen,        hpRegenPerSecRest = hpNatPerSec + hpRestExtraPerSec
mmud_explorer,modExpPerHour.bas,772,regen,        If hpRegenPerSecRest > 0# Then
mmud_explorer,modExpPerHour.bas,776,regen,            restHPSecs = hpDeficit / hpRegenPerSecRest
mmud_explorer,modExpPerHour.bas,781,regen,            'Apply HP regen during HP rest
mmud_explorer,modExpPerHour.bas,782,regen,            HPcur = HPcur + hpRegenPerSecRest * restHPSecs
mmud_explorer,modExpPerHour.bas,785,regen,            'Natural MP regen during HP rest
mmud_explorer,modExpPerHour.bas,797,regen,        mpRegenPerSecRest = mpNatPerSec + mpMedExtraPerSec
mmud_explorer,modExpPerHour.bas,798,regen,        If mpRegenPerSecRest > 0# Then
mmud_explorer,modExpPerHour.bas,802,regen,            restMPSecs = mpDeficit / mpRegenPerSecRest
mmud_explorer,modExpPerHour.bas,807,regen,            'Apply MP regen during MP rest
mmud_explorer,modExpPerHour.bas,808,regen,            MPcur = MPcur + mpRegenPerSecRest * restMPSecs
mmud_explorer,modExpPerHour.bas,811,regen,            'Natural HP regen during MP rest
mmud_explorer,modExpPerHour.bas,846,regen,"    Optional ByVal nExp As Currency = 0@, Optional ByVal nRegenTime As Double = 0#, Optional ByVal nNumMobs As Double = 1#, _"
mmud_explorer,modExpPerHour.bas,848,regen,"    Optional ByVal nCharDMG As Double = 0#, Optional ByVal nCharHP As Long = 0#, Optional ByVal nCharHPRegen As Long = 0#, _"
mmud_explorer,modExpPerHour.bas,849,regen,"    Optional ByVal nMobDmg As Double = 0#, Optional ByVal nMobHP As Long = 0#, Optional ByVal nMobHPRegen As Long = 0#, _"
mmud_explorer,modExpPerHour.bas,851,regen,"    Optional ByVal nCharMana As Integer = 0#, Optional ByVal nCharMPRegen As Long = 0#, Optional ByVal nMeditateRate As Long = 0#, _"
mmud_explorer,modExpPerHour.bas,896,regen,"        cephC_DebugPrint ""  nExp="" & Format$(nExp, ""0"") & ""; nRegenTime="" & Format$(nRegenTime, ""0.00"")"
mmud_explorer,modExpPerHour.bas,900,regen,"        cephC_DebugPrint ""  CharHP="" & CStr(nCharHP) & ""; HPRegen="" & CStr(nCharHPRegen) & ""; DamageThreshold="" & CStr(nDamageThreshold)"
mmud_explorer,modExpPerHour.bas,901,regen,"        cephC_DebugPrint ""  CharMana="" & CStr(nCharMana) & ""; MPRegen="" & CStr(nCharMPRegen) & ""; MeditateRate="" & CStr(nMeditateRate)"
mmud_explorer,modExpPerHour.bas,916,regen,                    nMobHPRegen)
mmud_explorer,modExpPerHour.bas,920,regen,"                    nExp, nRegenTime, nNumMobs, nTotalLairs, nPossSpawns, nAvgWalk, _"
mmud_explorer,modExpPerHour.bas,921,regen,"                    nWalkSpeed, nCharHP, nCharHPRegen, nCharMana, nCharMPRegen, _"
mmud_explorer,modExpPerHour.bas,923,regen,"                    nMobDmg, nMobHP, nMobHPRegen, nCharDMG, nCharFirstRoundDMG, _"
mmud_explorer,modExpPerHour.bas,926,regen,    ' Boss-style lair: single spawn on a long timer (nRegenTime is HOURS here).
mmud_explorer,modExpPerHour.bas,927,regen,    bIsBoss = (nTotalLairs <= 0) And (nRegenTime > 0#)
mmud_explorer,modExpPerHour.bas,982,36,    '   - Unlimited lairs/hr: 3600 / cycleSecs.
mmud_explorer,modExpPerHour.bas,983,regen,    '   - Spawn supply (if lairs>0 & regen>0): nTotalLairs * (60 / nRegenTime).
mmud_explorer,modExpPerHour.bas,985,36,    lairsPerHourUn = 3600# / totalSecs
mmud_explorer,modExpPerHour.bas,987,regen,    If (nTotalLairs > 0) And (nRegenTime > 0#) Then
mmud_explorer,modExpPerHour.bas,988,regen,        lairsPerHourSupply = CDbl(nTotalLairs) * (60# / nRegenTime)
mmud_explorer,modExpPerHour.bas,1006,36,    roamPerHour = 3600# - (attackPerHour + movePerHour + restHPPerHour + restMPPerHour)
mmud_explorer,modExpPerHour.bas,1058,regen,            If SEC_PER_REGEN_TICK > 0# Then
mmud_explorer,modExpPerHour.bas,1059,regen,                hpNatPerSec = (CDbl(nCharHPRegen) / 3#) / SEC_PER_REGEN_TICK
mmud_explorer,modExpPerHour.bas,1060,regen,                mpNatPerSec = CDbl(nCharMPRegen) / SEC_PER_REGEN_TICK
