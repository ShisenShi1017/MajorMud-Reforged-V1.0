<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Reforged.App.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MajorMudReforged</AssemblyName>
    <RootNamespace>Reforged.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\Release\MajorMudReforgedApp\</PublishDir>
    <PublicRelease Condition="'$(PublicRelease)' == ''">false</PublicRelease>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Reforged.Server.Runtime/Reforged.Server.Runtime.csproj" />
    <ProjectReference Include="../../Compiler/MajorMud.Reforged.Compiler.csproj" />
  </ItemGroup>

  <!-- Private/development-only AI dependencies. Public releases do not restore them. -->
  <ItemGroup Condition="'$(PublicRelease)' != 'true'">
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Normal development build: keep Borin and exclude the alternate public composition. -->
  <ItemGroup Condition="'$(PublicRelease)' != 'true'">
    <Compile Remove="App.PublicRelease.cs" />
    <Page Remove="MainWindow.PublicRelease.xaml" />
    <Resource Include="Assets\Borin\BorinIronbeard.png" />
    <Resource Include="Assets\Borin\BorinLivingForgeHeader.png" />
  </ItemGroup>

  <!-- Public build: swap composition roots and fail closed around all private Borin surfaces. -->
  <ItemGroup Condition="'$(PublicRelease)' == 'true'">
    <Compile Remove="App.xaml.cs" />
    <Page Remove="MainWindow.xaml" />

    <Compile Remove="Brains\**\*.cs" />
    <Compile Remove="BorinCapabilities\**\*.cs" />
    <Compile Remove="Forge\**\*.cs" />
    <Compile Remove="Engineering\**\*.cs" />
    <Compile Remove="ViewModels\BorinForgeViewModel.cs" />
    <Compile Remove="Views\Borin*.xaml.cs" />
    <Compile Remove="Views\NvidiaApiKeyWindow.xaml.cs" />

    <Page Remove="Views\Borin*.xaml" />
    <Page Remove="Views\NvidiaApiKeyWindow.xaml" />
    <Resource Remove="Assets\Borin\**\*" />
  </ItemGroup>

  <Target Name="PrunePublishedReleaseExtras" AfterTargets="Publish">
    <ItemGroup>
      <ReleaseExtras Include="$(PublishDir)runtimes\linux-x64\**\*" />
      <ReleaseExtras Include="$(PublishDir)**\*.pdb" />
      <ReleaseExtras Include="$(PublishDir)cs\**\*" />
      <ReleaseExtras Include="$(PublishDir)de\**\*" />
      <ReleaseExtras Include="$(PublishDir)es\**\*" />
      <ReleaseExtras Include="$(PublishDir)fr\**\*" />
      <ReleaseExtras Include="$(PublishDir)it\**\*" />
      <ReleaseExtras Include="$(PublishDir)ja\**\*" />
      <ReleaseExtras Include="$(PublishDir)ko\**\*" />
      <ReleaseExtras Include="$(PublishDir)pl\**\*" />
      <ReleaseExtras Include="$(PublishDir)pt-BR\**\*" />
      <ReleaseExtras Include="$(PublishDir)ru\**\*" />
      <ReleaseExtras Include="$(PublishDir)tr\**\*" />
      <ReleaseExtras Include="$(PublishDir)zh-Hans\**\*" />
      <ReleaseExtras Include="$(PublishDir)zh-Hant\**\*" />
    </ItemGroup>
    <Delete Files="@(ReleaseExtras)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)runtimes\linux-x64;$(PublishDir)cs;$(PublishDir)de;$(PublishDir)es;$(PublishDir)fr;$(PublishDir)it;$(PublishDir)ja;$(PublishDir)ko;$(PublishDir)pl;$(PublishDir)pt-BR;$(PublishDir)ru;$(PublishDir)tr;$(PublishDir)zh-Hans;$(PublishDir)zh-Hant" />
  </Target>
</Project>
