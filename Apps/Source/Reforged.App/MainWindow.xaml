<Window x:Class="Reforged.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MajorMUD Reforged" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource ShellBackground}" TextElement.Foreground="{StaticResource TextBrush}">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10" TextElement.Foreground="{StaticResource TextBrush}">
      <Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MajorMUD Reforged" FontSize="25" FontWeight="Bold"/>
          <TextBlock Text="Unified Application" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="Profile: Default" Margin="10" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="World: Classic" Margin="10" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="{Binding HostState}" Margin="10" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="settings" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#10161D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12" TextElement.Foreground="{StaticResource TextBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Exit" Command="{Binding ExitCommand}" Style="{StaticResource NavigationButtonStyle}"/>
          <StackPanel>
            <Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="home" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Play" Command="{Binding NavigateCommand}" CommandParameter="play" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Host" Command="{Binding NavigateCommand}" CommandParameter="host" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Editor" Command="{Binding NavigateCommand}" CommandParameter="editor" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Librarium" Command="{Binding NavigateCommand}" CommandParameter="librarium" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="The Forge" Command="{Binding NavigateCommand}" CommandParameter="forge" Style="{StaticResource NavigationButtonStyle}" ToolTip="Talk with the Reforged development Guardian"/>
            <Button Content="Guardian Hall" Command="{Binding NavigateCommand}" CommandParameter="guardians" Style="{StaticResource NavigationButtonStyle}" ToolTip="Assign and manage the Five AI Guardians"/>
            <Button Content="Characters" Command="{Binding NavigateCommand}" CommandParameter="characters" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Server" Command="{Binding NavigateCommand}" CommandParameter="server" Style="{StaticResource NavigationButtonStyle}"/>
            <Button Content="Tools" Command="{Binding NavigateCommand}" CommandParameter="tools" Style="{StaticResource NavigationButtonStyle}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Background="{StaticResource ShellBackground}">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" TextElement.Foreground="{StaticResource TextBrush}">
          <TextBlock Text="{Binding ActiveTitle}" FontSize="21" FontWeight="SemiBold" Margin="20,13" Foreground="{StaticResource TextBrush}"/>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding ActiveView}"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7" TextElement.Foreground="{StaticResource TextBrush}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding HostState}" Margin="0,0,24,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding ConnectionState}" Margin="0,0,24,0" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding SessionState}" Margin="0,0,24,0" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="World: Classic" Margin="0,0,24,0" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Scheduler: Runtime" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Runtime health: Ready" Margin="24,0,0,0" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
