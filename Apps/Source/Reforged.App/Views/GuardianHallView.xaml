<UserControl x:Class="Reforged.App.Views.GuardianHallView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowDrop="True" Drop="OnDrop">
 <UserControl.Resources>
  <SolidColorBrush x:Key="GuardianInkBrush" Color="#16110B"/>
  <SolidColorBrush x:Key="GuardianMutedInkBrush" Color="#3A2A1A"/>
  <SolidColorBrush x:Key="GuardianFieldBrush" Color="#F6E2AF"/>
  <SolidColorBrush x:Key="GuardianFieldAltBrush" Color="#E8CC91"/>
  <SolidColorBrush x:Key="GuardianSelectionBrush" Color="#D49A47"/>
  <SolidColorBrush x:Key="GuardianButtonBrush" Color="#E7D09A"/>
  <SolidColorBrush x:Key="GuardianButtonHoverBrush" Color="#F1DBA8"/>
  <SolidColorBrush x:Key="GuardianButtonPressedBrush" Color="#C88732"/>
  <Style TargetType="ContentControl">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="Label">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="Run">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianButtonBrush}"/>
   <Setter Property="BorderBrush" Value="#74502A"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="{StaticResource GuardianButtonHoverBrush}"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="{StaticResource GuardianButtonPressedBrush}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Foreground" Value="#6A5A45"/>
     <Setter Property="Background" Value="#C6B08A"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource GuardianSelectionBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="BorderBrush" Value="#5D3819"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
   <Setter Property="CaretBrush" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="BorderBrush" Value="#74502A"/>
   <Setter Property="SelectionBrush" Value="{StaticResource GuardianSelectionBrush}"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
   <Setter Property="BorderBrush" Value="#74502A"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Margin" Value="5,8"/>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Margin" Value="5,8"/>
  </Style>
  <Style TargetType="ItemsControl">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
   <Setter Property="BorderBrush" Value="#74502A"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="{StaticResource GuardianSelectionBrush}"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="#EFD39C"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
   <Setter Property="RowBackground" Value="{StaticResource GuardianFieldBrush}"/>
   <Setter Property="AlternatingRowBackground" Value="{StaticResource GuardianFieldAltBrush}"/>
   <Setter Property="BorderBrush" Value="#74502A"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#A5793B"/>
   <Setter Property="VerticalGridLinesBrush" Value="#A5793B"/>
   <Setter Property="TextElement.Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="TextElement.Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="{StaticResource GuardianSelectionBrush}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="TextElement.Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
     <Setter Property="Background" Value="{StaticResource GuardianSelectionBrush}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldAltBrush}"/>
   <Setter Property="TextElement.Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style x:Key="GuardianGridTextElement" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="GuardianGridTextEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
  </Style>
  <Style x:Key="GuardianGridComboElement" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/>
   <Setter Property="Background" Value="{StaticResource GuardianFieldBrush}"/>
  </Style>
  <Style x:Key="ParchmentPanel" TargetType="Border">
   <Setter Property="Background" Value="#FFF4D6"/><Setter Property="BorderBrush" Value="#8B6A3E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="TextElement.Foreground" Value="{StaticResource GuardianInkBrush}"/>
  </Style>
  <Style x:Key="RealmKeeperPanel" TargetType="Border" BasedOn="{StaticResource ParchmentPanel}"><Setter Property="Background" Value="#F2E2B7"/><Setter Property="BorderBrush" Value="#6E4F2D"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style x:Key="WandererPanel" TargetType="Border" BasedOn="{StaticResource ParchmentPanel}"><Setter Property="Background" Value="#E6E3C0"/><Setter Property="BorderBrush" Value="#61714A"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style x:Key="AnalystPanel" TargetType="Border" BasedOn="{StaticResource ParchmentPanel}"><Setter Property="Background" Value="#E3E1D7"/><Setter Property="BorderBrush" Value="#58616A"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style x:Key="WorldsmithPanel" TargetType="Border" BasedOn="{StaticResource ParchmentPanel}"><Setter Property="Background" Value="#EBD6BA"/><Setter Property="BorderBrush" Value="#8A4E2C"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style x:Key="ArchivistPanel" TargetType="Border" BasedOn="{StaticResource ParchmentPanel}"><Setter Property="Background" Value="#E5DCC7"/><Setter Property="BorderBrush" Value="#594A6B"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style x:Key="ChamberBadge" TargetType="Border"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="#493822"/></Style>
  <Style x:Key="RoomTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,8,0,6"/><Setter Property="Foreground" Value="{StaticResource GuardianInkBrush}"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,2"/></Style>
 </UserControl.Resources>
 <Grid Background="#241D18" Margin="12" TextElement.Foreground="{StaticResource GuardianInkBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource ParchmentPanel}" Margin="0,0,0,10" Background="#E7D09A">
   <Grid><StackPanel><TextBlock Text="Guardian Hall" FontSize="30" FontWeight="Bold"/><TextBlock Text="Five distinct chambers for realm stewardship, exploration, analysis, creation, and Librarium evidence."/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#493822" CornerRadius="12" Padding="12,5"><TextBlock Text="{Binding HallStatus}" Foreground="#FFF5D8" FontWeight="SemiBold"/></Border></Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource ParchmentPanel}" Background="#D8BD82">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="The Five Chambers" Style="{StaticResource RoomTitle}" Margin="0,0,0,10"/>
     <ListBox ItemsSource="{Binding Guardians}" SelectedItem="{Binding SelectedGuardian}" Background="Transparent" BorderThickness="0">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#9C7746" BorderThickness="1" CornerRadius="6" Padding="10" Background="#F9EBC5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontSize="28" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding Title}"/><Border Background="#6B5130" CornerRadius="8" HorizontalAlignment="Left" Padding="7,2" Margin="0,4,0,0"><TextBlock Text="{Binding Status}" Foreground="White" FontSize="10"/></Border></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource ParchmentPanel}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="92" Height="92" Background="#5B4328" CornerRadius="46"><TextBlock Text="{Binding SelectedGuardian.Icon}" FontSize="48" Foreground="#FFE9B4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding SelectedIdentity}" Style="{StaticResource RoomTitle}"/><TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding SelectedPersonality}" FontStyle="Italic" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedAppearance}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#6B5235"/></StackPanel></Grid></Border>

      <Expander Header="⚒  BORIN ENGINEERING DEPARTMENT" IsExpanded="True" Margin="0,0,0,10">
       <Border Style="{StaticResource ParchmentPanel}" Background="#E9D5A4" BorderBrush="#765122" BorderThickness="2">
        <StackPanel>
         <DockPanel>
          <StackPanel><TextBlock Text="Guardian Hall Engineering" Style="{StaticResource RoomTitle}"/><TextBlock Text="Cumulative candidate packages by default. Live repository authority is independently operator controlled." TextWrapping="Wrap"/></StackPanel>
          <Border DockPanel.Dock="Right" Background="#493822" CornerRadius="10" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="{Binding Engineering.Status.Summary}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="430"/></Border>
         </DockPanel>
         <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Operator Controls" Style="{StaticResource SectionTitle}"/>
           <CheckBox Content="Autonomous engineering ON" IsChecked="{Binding Engineering.Configuration.AutonomousEngineeringEnabled}" FontWeight="Bold"/>
           <TextBlock Text="When off, Start Working creates a ready session but does not run the queue. When on, Borin works through guarded phases inside an isolated Git workspace." TextWrapping="Wrap" Margin="5,0,0,6"/>
           <CheckBox Content="ALLOW LIVE REPOSITORY EDITS (future direct-runtime mode)" IsChecked="{Binding Engineering.Configuration.AllowLiveRepositoryEdits}" Foreground="#7A2018" FontWeight="Bold"/>
           <TextBlock Text="Keep this off for cumulative ZIP workflow. This authority is separate from autonomy; enabling autonomy does not enable live edits." TextWrapping="Wrap" Margin="5,0,0,6"/>
           <WrapPanel><CheckBox Content="Build" IsChecked="{Binding Engineering.Configuration.RunBuilds}"/><CheckBox Content="Validate" IsChecked="{Binding Engineering.Configuration.RunValidation}"/><CheckBox Content="Runtime smoke" IsChecked="{Binding Engineering.Configuration.RunRuntimeDiagnostics}"/><CheckBox Content="Cumulative ZIP" IsChecked="{Binding Engineering.Configuration.GenerateCandidatePackages}"/></WrapPanel>
           <WrapPanel Margin="0,8,0,0"><Button Content="START WORKING" Command="{Binding StartEngineeringCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,8"/><Button Content="STOP WORKING" Command="{Binding StopEngineeringCommand}" Background="#7A2018" Foreground="White" Padding="18,8"/><Button Content="Queue All Phases" Command="{Binding QueueEngineeringPhasesCommand}"/><Button Content="Run One Step" Command="{Binding RunEngineeringStepCommand}"/><Button Content="Save Controls" Command="{Binding SaveEngineeringCommand}"/></WrapPanel>
           <TextBlock Margin="0,8,0,0"><Run Text="Workspace: "/><Run Text="{Binding Engineering.Status.WorkspacePath}"/></TextBlock>
           <TextBlock><Run Text="Session: "/><Run Text="{Binding Engineering.Status.CurrentSessionId}"/><Run Text=" · Health: "/><Run Text="{Binding Engineering.Status.Health}"/></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="Phase Capability Status" Style="{StaticResource SectionTitle}"/>
           <ItemsControl ItemsSource="{Binding Engineering.CapabilityStatus}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
           <TextBlock Text="Engineering Queue" Style="{StaticResource SectionTitle}"/>
           <DataGrid ItemsSource="{Binding Engineering.Tasks}" AutoGenerateColumns="False" Height="145" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns><DataGridTextColumn Header="Task" Binding="{Binding Title}" ElementStyle="{StaticResource GuardianGridTextElement}" Width="*"/><DataGridTextColumn Header="Phase" Binding="{Binding Category}" ElementStyle="{StaticResource GuardianGridTextElement}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource GuardianGridTextElement}" Width="90"/><DataGridTextColumn Header="Result" Binding="{Binding Result}" ElementStyle="{StaticResource GuardianGridTextElement}" Width="1.5*"/></DataGrid.Columns>
           </DataGrid>
           <TextBlock><Run Text="Memory entries: "/><Run Text="{Binding Engineering.Memory.Count}"/><Run Text=" · Reports: "/><Run Text="{Binding Engineering.Reports.Count}"/><Run Text=" · Completed: "/><Run Text="{Binding Engineering.Statistics.TasksCompleted}"/><Run Text=" · Failed: "/><Run Text="{Binding Engineering.Statistics.TasksFailed}"/></TextBlock>
          </StackPanel>
         </Grid>
        </StackPanel>
       </Border>
      </Expander>

      <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource RealmKeeperPanel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRealmKeeper}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><TextBlock Text="Realm Keeper War Room" Style="{StaticResource RoomTitle}"/><Border Style="{StaticResource ChamberBadge}"><TextBlock Text="GLOBAL REALM COMMAND" Foreground="#FFF5D8" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="Global oversight across every connected world. No world or character assignment." Margin="0,0,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Server Scope" Style="{StaticResource SectionTitle}"/><CheckBox Content="Local Host" IsChecked="{Binding RealmKeeper.LocalHost}"/><CheckBox Content="LAN Host" IsChecked="{Binding RealmKeeper.LanHost}"/><CheckBox Content="Internet Host" IsChecked="{Binding RealmKeeper.InternetHost}"/>
         <TextBlock Text="World Coverage" Style="{StaticResource SectionTitle}"/><CheckBox Content="Classic" IsChecked="{Binding RealmKeeper.Classic}"/><CheckBox Content="Custom" IsChecked="{Binding RealmKeeper.Custom}"/><CheckBox Content="AI Worlds" IsChecked="{Binding RealmKeeper.AiWorlds}"/><CheckBox Content="Test Realms" IsChecked="{Binding RealmKeeper.TestRealms}"/>
         <TextBlock Text="Alert Thresholds" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RealmKeeper.AlertThresholds}"/><TextBlock Text="Auto Reports" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RealmKeeper.AutoReports}"/><TextBlock Text="Maintenance Window" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RealmKeeper.MaintenanceWindow}"/></StackPanel>
        <StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}"/><Button Grid.Column="1" Content="Refresh Telemetry" Command="{Binding RefreshRealmKeeperCommand}" Padding="12,5" Margin="8,4,0,4"/></Grid><WrapPanel><CheckBox Content="Population" IsChecked="{Binding RealmKeeper.Population}" Margin="0,0,14,4"/><CheckBox Content="Economy" IsChecked="{Binding RealmKeeper.Economy}" Margin="0,0,14,4"/><CheckBox Content="Events" IsChecked="{Binding RealmKeeper.Events}" Margin="0,0,14,4"/><CheckBox Content="Server Health" IsChecked="{Binding RealmKeeper.ServerHealth}" Margin="0,0,14,4"/><CheckBox Content="Combat" IsChecked="{Binding RealmKeeper.Combat}" Margin="0,0,14,4"/><CheckBox Content="Crashes" IsChecked="{Binding RealmKeeper.Crashes}" Margin="0,0,14,4"/><CheckBox Content="Scheduler" IsChecked="{Binding RealmKeeper.Scheduler}" Margin="0,0,14,4"/><CheckBox Content="Spawn Timers" IsChecked="{Binding RealmKeeper.SpawnTimers}" Margin="0,0,14,4"/><CheckBox Content="Hard Resets" IsChecked="{Binding RealmKeeper.HardResets}"/></WrapPanel>
         <WrapPanel Margin="0,8,0,4"><Border Background="#E7D09A" BorderBrush="#8B6A3E" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,6,6"><StackPanel><TextBlock Text="Connected Hosts" FontWeight="Bold"/><TextBlock Text="{Binding RealmKeeper.ConnectedHosts}" FontSize="20"/></StackPanel></Border><Border Background="#E7D09A" BorderBrush="#8B6A3E" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,6,6"><StackPanel><TextBlock Text="World Folders" FontWeight="Bold"/><TextBlock Text="{Binding RealmKeeper.CoveredWorlds}" FontSize="20"/></StackPanel></Border><Border Background="#E7D09A" BorderBrush="#8B6A3E" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,6,6"><StackPanel><TextBlock Text="Generated Records" FontWeight="Bold"/><TextBlock Text="{Binding RealmKeeper.GeneratedRecords}" FontSize="20"/></StackPanel></Border><Border Background="#E7D09A" BorderBrush="#8B6A3E" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,6,6"><StackPanel><TextBlock Text="Save Files" FontWeight="Bold"/><TextBlock Text="{Binding RealmKeeper.ActiveSaveFiles}" FontSize="20"/></StackPanel></Border></WrapPanel>
         <TextBlock Text="{Binding RealmKeeper.TelemetryStatus}" TextWrapping="Wrap" FontStyle="Italic"/><TextBlock Text="{Binding RealmKeeper.LastRefresh, StringFormat=Last refresh: {0}}" Margin="0,2,0,0"/>
         <DockPanel Margin="0,8,0,4"><TextBlock Text="Remote Host Telemetry" Style="{StaticResource SectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add Host" Command="{Binding AddRemoteHostCommand}" Padding="10,4" Margin="4"/><Button Content="Remove" Command="{Binding RemoveRemoteHostCommand}" Padding="10,4" Margin="4"/></StackPanel></DockPanel>
         <DataGrid ItemsSource="{Binding RealmKeeper.RemoteHosts}" SelectedItem="{Binding SelectedRemoteHost}" AutoGenerateColumns="False" CanUserAddRows="False" Height="150" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="38"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" Width="90"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" Width="60"/><DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" Width="160"/><DataGridTextColumn Header="Path" Binding="{Binding TelemetryPath}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" Width="145"/><DataGridTextColumn Header="Token Env Var" Binding="{Binding ApiTokenEnvironmentVariable}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource GuardianGridTextElement}" EditingElementStyle="{StaticResource GuardianGridTextEditor}" IsReadOnly="True" Width="100"/></DataGrid.Columns>
         </DataGrid>
         <TextBlock Text="Credentials are read from the named environment variable and are never stored in Guardian Hall state." TextWrapping="Wrap" FontStyle="Italic" Margin="0,3,0,5"/>
         <TextBlock Text="Current Realm Health" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding RealmKeeper.CurrentRealmHealth}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/><TextBlock Text="Live Activity" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding RealmKeeper.LiveActivity}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/><TextBlock Text="Realm Timeline" Style="{StaticResource SectionTitle}"/><ListBox ItemsSource="{Binding RealmKeeper.RealmTimeline}" Height="120"/></StackPanel>
       </Grid>
      </StackPanel>
     </Border>

     <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WandererPanel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWanderer}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><DockPanel><StackPanel><TextBlock Text="Wanderer Expedition Lodge" Style="{StaticResource RoomTitle}"/><Border Style="{StaticResource ChamberBadge}"><TextBlock Text="LIVE CHARACTER OPERATIONS" Foreground="#FFF5D8" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="A player-like field agent with a retained character assignment."/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh Session" Command="{Binding RefreshWandererCommand}" Padding="14,7" Margin="12,0,0,0"/></DockPanel><TextBlock Text="{Binding Wanderer.RuntimeStatus}" Margin="0,6,0,0"/><TextBlock Text="{Binding Wanderer.LastRefresh, StringFormat=Last refresh: {0}}" FontStyle="Italic"/><Border Background="#DCE8C8" BorderBrush="#486B38" BorderThickness="3" CornerRadius="8" Padding="14" Margin="0,12,0,12">
        <StackPanel>
         <DockPanel>
          <StackPanel>
           <TextBlock Text="AUTONOMOUS PLAYER CONTROL" FontSize="20" FontWeight="Bold" Foreground="#24451E"/>
           <TextBlock Text="Wanderer will repeatedly read the connected Play session and choose safe actions until paused." TextWrapping="Wrap"/>
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="#24451E" CornerRadius="10" Padding="10,4" VerticalAlignment="Center"><TextBlock Text="{Binding Wanderer.AutonomousStatus}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="360"/></Border>
         </DockPanel>
         <WrapPanel Margin="0,10,0,4"><CheckBox Content="Explore reported exits" IsChecked="{Binding Wanderer.AutonomousExplore}" Margin="0,0,16,4"/><CheckBox Content="Fight when engaged" IsChecked="{Binding Wanderer.AutonomousCombat}" Margin="0,0,16,4"/><CheckBox Content="Rest to recover" IsChecked="{Binding Wanderer.AutonomousRecovery}" Margin="0,0,16,4"/><CheckBox Content="Loot defeated enemies" IsChecked="{Binding Wanderer.AutonomousLoot}" Margin="0,0,16,4"/></WrapPanel>
         <WrapPanel Margin="0,5,0,0"><TextBlock Text="Action interval" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox Text="{Binding Wanderer.AutonomousIntervalSeconds}" Width="50" Margin="7,0,6,0"/><TextBlock Text="seconds   Maximum actions (0 = unlimited)" VerticalAlignment="Center"/><TextBox Text="{Binding Wanderer.AutonomousMaxActions}" Width="65" Margin="7,0,12,0"/><CheckBox Content="Allow guarded commands" IsChecked="{Binding Wanderer.AllowMissionDispatch}" VerticalAlignment="Center"/><TextBlock Text="Permission" VerticalAlignment="Center" Margin="12,0,5,0"/><ComboBox Width="135" ItemsSource="{Binding Permissions}" SelectedItem="{Binding Wanderer.Permission}"/></WrapPanel>
