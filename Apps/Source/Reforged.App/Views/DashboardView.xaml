<UserControl x:Class="Reforged.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="Welcome to MajorMUD Reforged" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
      <TextBlock Text="Choose an action to begin. The Host starts only when requested." Margin="0,8,0,22" Foreground="{StaticResource MutedTextBrush}" FontSize="15"/>
      <UniformGrid Columns="3">
        <Button Content="Continue Last Session" Command="{Binding OpenWorkspaceCommand}" CommandParameter="play" Style="{StaticResource PrimaryButtonStyle}"/>
        <Button Content="Play Classic" Command="{Binding OpenWorkspaceCommand}" CommandParameter="play"/>
        <Button Content="Connect to Host" Command="{Binding OpenWorkspaceCommand}" CommandParameter="server"/>
        <Button Content="Start Local Host" Command="{Binding StartLocalHostCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        <Button Content="Open Editor" Command="{Binding OpenWorkspaceCommand}" CommandParameter="editor"/>
        <Button Content="Open Librarium" Command="{Binding OpenWorkspaceCommand}" CommandParameter="librarium"/>
      </UniformGrid>
      <UniformGrid Columns="2" Margin="0,16,0,0">
        <GroupBox Header="Runtime Status">
          <StackPanel><TextBlock Text="{Binding HostStatus, StringFormat=Host: {0}}" FontSize="18" FontWeight="Bold"/><TextBlock Text="Unified shell ready. Runtime data remains authoritative outside the presentation layer." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource ParchmentMutedTextBrush}"/></StackPanel>
        </GroupBox>
        <GroupBox Header="Automatic Cleanup / Reset">
          <StackPanel><TextBlock Text="{Binding CleanupStatus}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding NextCleanup, StringFormat=Next: {0}}" Margin="0,6,0,8"/><WrapPanel><Button Content="Open Host Settings" Command="{Binding OpenWorkspaceCommand}" CommandParameter="host"/><Button Content="Run Cleanup Now" Command="{Binding RunCleanupNowCommand}"/></WrapPanel></StackPanel>
        </GroupBox>
      </UniformGrid>
      <GroupBox Header="Recent Activity" Margin="7,16,7,7"><TextBlock Text="Recent characters, worlds, errors, and warnings will appear here." Foreground="{StaticResource ParchmentMutedTextBrush}"/></GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
