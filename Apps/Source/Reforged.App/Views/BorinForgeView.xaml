        <Button Content="Send Supervised Command" Command="{Binding SendSupervisedPlayerCommand}" Style="{StaticResource ForgeButton}" Margin="3,0,3,5"/>
        <UniformGrid Columns="3">
         <Button Content="Pause" Command="{Binding PausePlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Resume" Command="{Binding ResumePlayerCommand}" Style="{StaticResource ForgeButton}"/>
