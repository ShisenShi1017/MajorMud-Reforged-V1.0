          <TextBlock Text="{Binding PlayerEnvironmentSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10" Margin="0,2,0,2"/>
          <TextBlock Text="{Binding PlayerPerceptionSummary}" TextWrapping="Wrap" Foreground="#E0E6E2" FontSize="10" Margin="0,0,0,2"/>
          <TextBlock Text="{Binding PlayerAutonomousPlaySummary}" TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="0,0,0,5"/>
          <UniformGrid Columns="3">
           <Button Content="Assignment Window" Click="OpenBorinAssignmentClicked" Style="{StaticResource ForgeButton}"/>
           <Button Content="Play by Himself" Command="{Binding StartAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Stop Playing" Command="{Binding StopAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}" Background="#651F1F" BorderBrush="#B54B4B"/>
          </UniformGrid>
          <TextBlock Text="Play by Himself remains locked until the exact active session has a fresh HP prompt, verified maximum HP, room title, and exit list. Human terminal input immediately returns control to William." TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>

        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,7,3,5">
