         <Button Content="Auto Reflection On / Off" Command="{Binding ToggleAutomaticReflectionCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Conversation Learning On / Off" Command="{Binding ToggleConversationLearningCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Player Help" Command="{Binding PlayerHelpCommand}" Style="{StaticResource ForgeButton}"/>
