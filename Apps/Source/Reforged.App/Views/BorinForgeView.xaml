        </UniformGrid>

        <TextBlock Text="LAST CONVERSATION" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold" Margin="3,7,3,2"/>
        <TextBlock Text="{Binding PlayerLastConversationSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,4"/>

        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,6,3,5">
         <StackPanel>
          <TextBlock Text="BORIN'S PRIVATE REFLECTION &amp; CONVERSATION JOURNAL" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding PlayerReflectionJournalSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,4"/>
          <TextBlock Text="CURRENT REFLECTION" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold"/>
          <TextBox Text="{Binding PlayerCurrentReflection, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="150" Style="{StaticResource ForgeTextBox}" Margin="0,2,0,5"/>
          <TextBlock Text="REFLECTION FOCUS" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold"/>
