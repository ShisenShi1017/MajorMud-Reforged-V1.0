<UserControl x:Class="Reforged.App.Views.BorinForgeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <UserControl.Resources>
  <SolidColorBrush x:Key="ForgePanel" Color="#E60E1214"/>
  <SolidColorBrush x:Key="ForgePanel2" Color="#E6171C1F"/>
  <SolidColorBrush x:Key="ForgeBorder" Color="#76552F"/>
  <SolidColorBrush x:Key="ForgeGold" Color="#D5A75D"/>
  <SolidColorBrush x:Key="ForgeText" Color="#F1E5D0"/>
  <Style x:Key="ForgeButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
   <Setter Property="Background" Value="#242A2E"/>
   <Setter Property="BorderBrush" Value="{StaticResource ForgeBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Background" Value="#49311D"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Background" Value="#6B3E1D"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ForgeTextBox" TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
   <Setter Property="Background" Value="#111619"/>
   <Setter Property="BorderBrush" Value="#5A6870"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="CaretBrush" Value="#F2B24D"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="#E4A84E"/>
   <Setter Property="Background" Value="#151B1E"/>
   <Setter Property="BorderBrush" Value="#4F4030"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Expander">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Margin="0,2">
       <DockPanel>
        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="#211A14" BorderThickness="0" Foreground="#E4A84E" Padding="9,7"
                      HorizontalContentAlignment="Left" Content="{TemplateBinding Header}" FontWeight="SemiBold"/>
        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
       </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>

 <Grid Background="#090C0E">
  <Grid.RowDefinitions>
   <RowDefinition Height="220"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="0"/>
  </Grid.RowDefinitions>

  <!-- Reserved live Borin stage. The image is the current fallback; animation and interaction layers belong here. -->
  <Border x:Name="LiveBorinForgeStage" Grid.Row="0" Margin="8,8,8,6" BorderBrush="#8C6239" BorderThickness="1" CornerRadius="9" ClipToBounds="True"
          ToolTip="Borin's live Forge stage">
   <Grid>
    <Image Source="pack://application:,,,/Assets/Borin/BorinLivingForgeHeader.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle>
     <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="#DD090B0D" Offset="0"/>
       <GradientStop Color="#55090B0D" Offset="0.35"/>
       <GradientStop Color="#22090B0D" Offset="0.65"/>
       <GradientStop Color="#CC090B0D" Offset="1"/>
      </LinearGradientBrush>
     </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="18,12">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="360"/>
     </Grid.ColumnDefinitions>

     <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="4,3,28,0">
      <TextBlock Text="BORIN" FontSize="28" FontWeight="Bold" Foreground="#F6D89A"/>
      <TextBlock Text="{Binding ModeSummary}" FontSize="12" Foreground="#D2B079"/>
     </StackPanel>

     <Border Grid.Column="1" Background="#C7141110" BorderBrush="#76552F" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,18,0" VerticalAlignment="Bottom">
      <StackPanel>
       <TextBlock Text="{Binding Status}" Foreground="#F3B34F" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="Type naturally: ask Borin to play, investigate, fix, build, test, train, or explain." Foreground="#AFC7B7" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>

     <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
      <Border Background="#D7141110" BorderBrush="#76552F" BorderThickness="1" CornerRadius="7" Padding="11">
       <StackPanel>
        <TextBlock Text="CURRENT TASK" FontWeight="Bold" Foreground="#E4A84E"/>
        <TextBlock Text="{Binding CurrentTask}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding TaskProgress, Mode=OneWay}" Margin="0,7,0,0"
                     Foreground="#62A84D" Background="#242A2E"/>
        <TextBlock Text="{Binding TaskStage}" HorizontalAlignment="Right" FontSize="10" Margin="0,3,0,0" Foreground="#C7B28E"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>

  <!-- Main workshop -->
  <Grid Grid.Row="1" Margin="8,0,8,6">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="0"/>
    <ColumnDefinition Width="0"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="330"/>
   </Grid.ColumnDefinitions>

   <!-- Library / project rail: compact dropdown sections -->
   <Border Grid.Column="0" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7" Padding="9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="LIBRARY &amp; PROJECT" FontSize="14" FontWeight="Bold" Foreground="#E4A84E" Margin="3,2,3,8"/>
      <Border Background="#151B1E" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
       <StackPanel>
        <TextBlock Text="ACTIVE REPOSITORY" FontWeight="Bold" Foreground="#BDA57F" FontSize="11"/>
        <TextBlock Text="{Binding Configuration.RepositoryPath}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"/>
       </StackPanel>
      </Border>

      <Expander Header="&#x1F4DA;  Repository" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <Button Content="Scan Repository" Command="{Binding ScanCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Open Solution" Command="{Binding OpenSolutionCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Inspect Tools" Command="{Binding ToolStatusCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F56F;  Study &amp; Research" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <Button Content="Study Host / Server" Command="{Binding StudyHostCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Study Entire Repository" Command="{Binding StudyRepositoryCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x2692;  Borin Capabilities" IsExpanded="True" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <TextBlock Text="{Binding BorinCapabilitiesSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,2,3,6"/>
        <Button Content="Capability Status" Command="{Binding CapabilityStatusCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Realm Health" Command="{Binding CapabilityRealmCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Analyze Progression" Command="{Binding CapabilityAnalysisCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Run Self-Test" Command="{Binding CapabilityDiagnosticsCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="STOP CAPABILITIES" Command="{Binding CapabilityStopCommand}" Style="{StaticResource ForgeButton}" Background="#651F1F" BorderBrush="#B54B4B"/>
        <TextBlock Text="Worldsmith is installed but withheld. Patch incorporation remains William-only." TextWrapping="Wrap" Foreground="#D7B36A" FontSize="10" Margin="3,5,3,0"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F4DC;  Attached Scrolls" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,2,0,5">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Background="#1B2226" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,2">
            <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" FontSize="11"/>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Attach File" Command="{Binding AttachFileCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Clear Attachments" Command="{Binding ClearAttachmentsCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <!-- Conversation -->
   <Border Grid.Column="2" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" Background="#171D20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="ASK BORIN" Margin="13,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4A84E"/>
      <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ForgeButton}" Padding="14,5" Margin="3,4,6,4"/>
     </Grid>

     <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" Background="#0B0F12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly" Padding="8">
      <ItemsControl x:Name="ChatList" ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
         <Setter Property="HorizontalAlignment" Value="Stretch"/>
         <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
       </ItemsControl.ItemContainerStyle>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Background="#10161A" BorderBrush="#69767C" BorderThickness="1" CornerRadius="6" Padding="12"
                 HorizontalAlignment="Stretch">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#E4A84E"/>
           <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="#8D9A9F" FontSize="11"/>
           <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                    Margin="0,7,0,0" Foreground="#FFFFFFFF" Background="Transparent" BorderThickness="0"
                    Padding="0" FontSize="15" FontWeight="SemiBold" IsReadOnly="True" IsTabStop="False"
                    VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>

     <Border Grid.Row="2" Background="#111619" BorderBrush="#39454A" BorderThickness="1,1,1,0" Padding="8">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" MaxHeight="145"
                VerticalScrollBarVisibility="Auto" Style="{StaticResource ForgeTextBox}" FontSize="14"
                ToolTip="Ask Borin naturally to play, investigate, fix, build, test, train, or explain."/>
       <Button Grid.Column="1" Content="Attach" Command="{Binding AttachFileCommand}" Style="{StaticResource ForgeButton}" Padding="13,12"/>
       <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ForgeButton}" Padding="13,12"/>
       <Button Grid.Column="3" Content="ASK BORIN" Command="{Binding SendCommand}" Style="{StaticResource ForgeButton}"
               Background="#184E74" BorderBrush="#408FBD" Padding="18,12"/>
      </Grid>
     </Border>
    </Grid>
   </Border>

   <!-- Workbench: dropdown action groups -->
   <Border Grid.Column="4" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
     <StackPanel>
      <TextBlock Text="DETAILS &amp; SETTINGS" FontSize="14" FontWeight="Bold" Foreground="#E4A84E"/>
      <TextBlock Text="Most work is controlled through chat. Open these sections only when direct status or configuration is needed."
                 TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="0,5,0,8"/>

      <Expander Header="&#x1F3AE;  Live Session" IsExpanded="True" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding PlayerLoginStatusSummary}" TextWrapping="Wrap" Foreground="#E4A84E" FontWeight="Bold" Margin="3,2"/>
        <TextBlock Text="{Binding PlayerEnvironmentSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,2"/>
        <TextBlock Text="{Binding PlayerPerceptionSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,2"/>
        <TextBlock Text="{Binding PlayerAutonomousPlaySummary}" TextWrapping="Wrap" Foreground="#D7B36A" FontSize="10.5" Margin="3,0,3,5"/>
        <TextBlock Text="GAME SERVER" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,5,3,2"/>
        <Grid Margin="3,0,3,3">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerHostName, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP address or hostname, such as omniversebbs.com" Style="{StaticResource ForgeTextBox}" MinHeight="30"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server port" Style="{StaticResource ForgeTextBox}" MinHeight="30"/>
        </Grid>
        <TextBlock Text="Enter an IP address or domain name without http:// or https://." TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="3,0,3,3"/>
        <Button Content="Save Server Profile" Command="{Binding SavePlayerProfileCommand}" Style="{StaticResource ForgeButton}"/>
        <UniformGrid Columns="2">
         <Button Content="Connect &amp; Login" Command="{Binding ConnectPlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Open Terminal" Click="OpenBorinTerminalClicked" Style="{StaticResource ForgeButton}"/>
         <Button Content="Play by Himself" Command="{Binding StartAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Stop Playing" Command="{Binding StopAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Disconnect" Command="{Binding DisconnectPlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Emergency Stop" Command="{Binding EmergencyStopPlayerCommand}" Style="{StaticResource ForgeButton}" Background="#651F1F" BorderBrush="#B54B4B"/>
        </UniformGrid>
        <TextBlock Text="SECURE PLAYER PASSWORD" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,7,3,2"/>
        <PasswordBox x:Name="CompactBorinPlayerPasswordBox" Foreground="{StaticResource ForgeText}" Background="#111619"
                     BorderBrush="#5A6870" BorderThickness="1" Padding="9" MinHeight="30" Margin="3,0,3,3" PasswordChar="*"/>
        <TextBlock Text="{Binding PlayerPasswordStatus}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10" Margin="3,0,3,3"/>
        <UniformGrid Columns="2">
         <Button Content="Save Password" Click="SaveBorinPasswordClicked" Style="{StaticResource ForgeButton}"/>
         <Button Content="Clear Password" Click="ClearBorinPasswordClicked" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F6E0;  Engineering Review" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding EngineeringJobStage}" TextWrapping="Wrap" Foreground="#E4A84E" FontWeight="Bold" Margin="3,2"/>
        <TextBlock Text="{Binding EngineeringJobSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="3,0,3,5"/>
        <UniformGrid Columns="2">
         <Button Content="Show Changes" Command="{Binding ShowEngineeringChangesCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Build &amp; Test" Command="{Binding BuildTestEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Reject" Command="{Binding RejectEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Review &amp; Incorporate" Command="{Binding IncorporateEngineeringJobCommand}" Style="{StaticResource ForgeButton}" Background="#6A3518" BorderBrush="#D58A3A"/>
        </UniformGrid>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F4DA;  Knowledge" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding KnowledgeIndexSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="3,2"/>
        <TextBlock Text="{Binding MajorMudKnowledgeSummary}" TextWrapping="Wrap" Foreground="#79C99E" Margin="3,2"/>
        <TextBlock Text="{Binding AcademyMajorMudMastery}" TextWrapping="Wrap" Foreground="#D7B36A" Margin="3,2"/>
        <TextBlock Text="{Binding AcademyReforgedMastery}" TextWrapping="Wrap" Foreground="#D7B36A" Margin="3,2"/>
        <TextBlock Text="Ask Borin to reindex, train, test mastery, investigate gaps, or show conflicts." TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,5,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F9E0;  AI Engine" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <ComboBox ItemsSource="{Binding BrainModes}" SelectedItem="{Binding SelectedBrainMode, Mode=TwoWay}" Margin="3,2,3,5" Padding="7,3"/>
        <TextBlock Text="{Binding LightningConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="3,2"/>
        <TextBlock Text="{Binding SuperConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="3,2"/>
        <TextBlock Text="{Binding UltraConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="3,2,3,5"/>
        <UniformGrid Columns="2">
         <Button Content="Change NVIDIA Key" Command="{Binding ChangeLightningKeyCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Lightning" Command="{Binding TestLightningCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Super" Command="{Binding TestSuperCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Ultra" Command="{Binding TestUltraCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <CheckBox Content="Automatic deep-reasoning escalation" IsChecked="{Binding AutomaticallyEscalateDifficultTasks, Mode=TwoWay}" Margin="5,6,3,2"/>
        <CheckBox Content="Verify critical work with Super" IsChecked="{Binding VerifyCriticalTasks, Mode=TwoWay}" Margin="5,2,3,2"/>
        <TextBlock Text="{Binding LastAiRouteSummary}" TextWrapping="Wrap" Foreground="#D7B36A" FontSize="10.5" Margin="3,5,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x2699;  Advanced" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Choose Borin Portrait" Command="{Binding ChoosePortraitCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Load / Tune Local Brain" Command="{Binding LoadModelsCommand}" Style="{StaticResource ForgeButton}"/>
        <TextBlock Text="Repository tools, memory inspection, Academy operations, traces, diagnostics, and workspace operations are available by asking Borin in chat." TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,5,3,2"/>
       </StackPanel>
      </Expander>
     </StackPanel>

     <!-- Retained command bindings for compatibility; these legacy controls are intentionally hidden in the chat-first UI. -->
     <StackPanel Visibility="Collapsed">
      <TextBlock Text="DETAILS &amp; SETTINGS" FontSize="14" FontWeight="Bold" Foreground="#E4A84E"/>
      <Border Background="#151B1E" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,7,0,8">
       <StackPanel>
        <TextBlock Text="CURRENT STATUS" FontWeight="Bold" Foreground="#BDA57F" FontSize="11"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#D6C3A6"/>
       </StackPanel>
      </Border>

      <Expander Header="&#x1F3AE;  Borin Active Player &amp; Parity Research" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding PlayerStatusSummary}" TextWrapping="Wrap" Margin="3,2,3,3" Foreground="#E4A84E" FontWeight="Bold"/>
        <TextBlock Text="{Binding PlayerSafetySummary}" TextWrapping="Wrap" Margin="3,0,3,3" Foreground="#AFC7B7"/>
        <TextBlock Text="{Binding PlayerStatusDetail}" TextWrapping="Wrap" Margin="3,0,3,7" Foreground="#9EAAA5" FontSize="10.5"/>

        <TextBlock Text="EXISTING BORIN SESSION &#x2014; SECURE LOGIN" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold" Margin="3,2,3,3"/>
        <TextBlock Text="{Binding PlayerLoginStatusSummary}" TextWrapping="Wrap" Foreground="#E4A84E" FontSize="10.5" FontWeight="Bold" Margin="3,0,3,2"/>
        <TextBlock Text="{Binding PlayerLoginStatusDetail}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="3,0,3,5"/>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerHostName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse BBS hostname" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse BBS port" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerLoginName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse User-ID" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerCharacterName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Borin MajorMUD character name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerSessionId, Mode=OneWay}" IsReadOnly="True" ToolTip="Existing Borin terminal session ID; this login pass does not create another session" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerServerProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server profile name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerWorldName, UpdateSourceTrigger=PropertyChanged}" ToolTip="MajorMUD world name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerPrimaryTeacher, UpdateSourceTrigger=PropertyChanged}" ToolTip="Primary human teacher" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <TextBox Text="{Binding PlayerMentorAiName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Known AI mentor subject to the three-reply loop guard" Style="{StaticResource ForgeTextBox}" MinHeight="28" Margin="3,0,3,4"/>

