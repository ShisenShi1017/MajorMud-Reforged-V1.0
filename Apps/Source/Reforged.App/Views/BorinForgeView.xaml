        </StackPanel>
        <TextBlock Text="Academy scores come only from current evidence-based evaluations. Training yields immediately to user, gameplay, Sysop, or engineering work and never turns model output into authority."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,6,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x26D3;  Classic Trace Chain" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding ClassicTraceSummary}" TextWrapping="Wrap" Margin="3,2,3,7" Foreground="#AFC7B7"/>
        <UniformGrid Columns="2">
         <Button Content="Show Last Trace" Command="{Binding ShowClassicTraceCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Trace Help" Command="{Binding ClassicTraceHelpCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <TextBlock Text="Use /trace &lt;question&gt; to follow decoded source &#x2192; Librarium &#x2192; generated Data/Classic &#x2192; runtime catalog &#x2192; live runtime consumer &#x2192; persistence/reset/cleanup &#x2192; parity validation."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,6,3,2"/>
        <TextBlock Text="Each stage is reported separately. Matching evidence never proves the next stage, and imported databases remain reference-only."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F9E0;  Local Brain &amp; NVIDIA" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding BrainStatus}" TextWrapping="Wrap" Margin="3,2,3,5"/>
        <TextBlock Text="{Binding BrainPerformanceSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="11" Margin="3,0,3,7"/>
        <UniformGrid Columns="2">
         <Button Content="Load Local Brain" Command="{Binding LoadModelsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Local Brain" Command="{Binding TestBrainCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <TextBlock Text="PERFORMANCE PRESET" Foreground="#BDA57F" FontSize="11" FontWeight="Bold" Margin="3,9,3,3"/>
        <Grid Margin="3,0,3,3">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox ItemsSource="{Binding BrainPerformancePresets}" SelectedItem="{Binding SelectedBrainPerformancePreset, Mode=TwoWay}"
                   MinHeight="28" Padding="7,3" VerticalContentAlignment="Center"/>
         <Button Grid.Column="1" Content="Apply &amp; Reload" Command="{Binding ApplyBrainPerformancePresetCommand}"
                 Style="{StaticResource ForgeButton}" Padding="10,5" Margin="6,0,0,0"/>
        </Grid>
        <TextBlock Text="Auto tunes memory use. Fast attempts maximum GPU offload, then falls back to the last working layer count."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,1,3,5"/>
        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3,7,3,0">
         <StackPanel>
          <TextBlock Text="MODEL" Foreground="#BDA57F" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="{Binding Configuration.ModelName}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock Text="Model folder: AI\Models" Foreground="#9EAAA5" FontSize="11" Margin="0,5,0,0"/>
          <TextBlock Text="Direct in-app GGUF; LM Studio is not used." Foreground="#9EAAA5" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
         </StackPanel>
        </Border>
        <Separator Margin="3,12,3,9" Background="#76552F"/>
        <TextBlock Text="NVIDIA NIM / HYBRID AI" Foreground="#E4A84E" FontWeight="Bold"/>
        <TextBlock Text="BRAIN MODE" Foreground="#BDA57F" FontSize="11" FontWeight="Bold" Margin="0,7,0,0"/>
        <ComboBox ItemsSource="{Binding BrainModes}" SelectedItem="{Binding SelectedBrainMode, Mode=TwoWay}"
                  Margin="3,4,3,8" Padding="7,3"/>
        <TextBlock Text="NORMAL MODEL" Foreground="#BDA57F" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Nemotron 3.5 Lightning 30B A3B" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,0"/>
        <TextBlock Text="Shared NVIDIA API Key: ••••••••••••••" Margin="0,7,0,0"/>
        <TextBlock Text="{Binding LightningConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding LightningRateSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,7"/>
        <UniformGrid Columns="2">
         <Button Content="Change NVIDIA Key" Command="{Binding ChangeLightningKeyCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Lightning" Command="{Binding TestLightningCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <Separator Margin="3,10,3,8" Background="#76552F"/>
        <TextBlock Text="INDEPENDENT VERIFIER" Foreground="#BDA57F" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Nemotron 3 Super 120B A12B" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding SuperConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding SuperRateSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,7"/>
        <Button Content="Test Super" Command="{Binding TestSuperCommand}" Style="{StaticResource ForgeButton}"/>
        <Separator Margin="3,10,3,8" Background="#76552F"/>
        <TextBlock Text="DEEP REASONING MODEL" Foreground="#BDA57F" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Nemotron 3 Ultra 550B A55B" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding UltraConnectionStatus}" TextWrapping="Wrap" Foreground="#F3B34F" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding UltraRateSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="0,2,0,7"/>
        <Button Content="Test Ultra" Command="{Binding TestUltraCommand}" Style="{StaticResource ForgeButton}"/>
        <CheckBox Content="Automatically escalate difficult tasks" IsChecked="{Binding AutomaticallyEscalateDifficultTasks, Mode=TwoWay}" Foreground="#F1E5D0" Margin="3,8,3,3"/>
        <CheckBox Content="Verify critical Ultra work independently with Super" IsChecked="{Binding VerifyCriticalTasks, Mode=TwoWay}" Foreground="#F1E5D0" Margin="3,3,3,3"/>
        <TextBlock Text="{Binding OverallNvidiaRateSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" Margin="3,2,3,0"/>
        <TextBlock Text="{Binding LastAiRouteSummary}" TextWrapping="Wrap" Foreground="#D7B36A" Margin="3,3,3,0"/>
        <TextBlock Text="Local state remains authoritative. Lightning handles normal reasoning, Ultra handles deep work, and Super independently verifies only critical Ultra decisions. All three use one secure key."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,6,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x2699;  Borin &amp; Forge" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <Button Content="Choose Alternate Portrait" Command="{Binding ChoosePortraitCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Save Forge Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </Border>
  </Grid>

  <!-- Workstation dock -->
  <Border Grid.Row="2" Margin="8,0,8,8" Background="#17110D" BorderBrush="#8C6239" BorderThickness="1" CornerRadius="7">
   <UniformGrid Columns="6" Margin="7">
    <Button Content="&#x1F4DA;  LIBRARY&#x0a;Study &amp; Research" Command="{Binding StudyRepositoryCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5"/>
    <Button Content="&#x1F6E0;  JOB STATUS&#x0a;Tracked Workflow" Command="{Binding ShowEngineeringJobCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5" Background="#4B2A12"/>
    <Button Content="&#x1F9E0;  LOCAL BRAIN&#x0a;Qwen GGUF" Command="{Binding LoadModelsCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5"/>
    <Button Content="&#x2705;  INCORPORATE&#x0a;Verified Patch" Command="{Binding IncorporateEngineeringJobCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5"/>
    <Button Content="&#x1F9EA;  BUILD &amp; TEST&#x0a;Isolated Snapshot" Command="{Binding BuildTestEngineeringJobCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5"/>
    <Button Content="&#x2699;  SETTINGS&#x0a;Borin &amp; System" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ForgeButton}" FontSize="12.5"/>
   </UniformGrid>
  </Border>
 </Grid>
</UserControl>
