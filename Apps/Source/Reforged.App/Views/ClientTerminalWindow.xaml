<Window x:Class="Reforged.App.Views.ClientTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Reforged.App.Views"
        Title="{Binding WindowTitle}"
        Width="1040"
        Height="760"
        MinWidth="760"
        MinHeight="500"
        Background="#F0F0F0"
        Foreground="#000000"
        FontFamily="Tahoma"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="ClassicToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#202020"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid>
            <DockPanel x:Name="ClassicWorkspace" Background="#F0F0F0">

                <DockPanel DockPanel.Dock="Top" Background="#F0F0F0" LastChildFill="True">
                    <Menu x:Name="ClassicMenuBar" Background="#F0F0F0" Foreground="#111111" Padding="0">
                        <MenuItem Header="_File">
                            <MenuItem Header="Connect" Click="ConnectClicked"/>
                            <MenuItem Header="Disconnect" Click="DisconnectClicked"/>
                            <MenuItem Header="Hangup" Click="DisconnectClicked"/>
                            <Separator/>
                            <MenuItem Header="New character..." Click="NewCharacterProfileClicked"/>
                            <MenuItem Header="Open character..." Click="OpenCharacterProfilesClicked"/>
                            <MenuItem Header="Save character" Click="SaveCharacterProfileClicked" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="Save As..." Click="SaveCharacterAsProfileClicked"/>
                            <Separator/>
                            <MenuItem Header="Exit" Click="CloseClicked"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="Copy command input" Click="CopyClicked" ToolTip="Copies the current local command input. Password input is never copied."/>
                            <MenuItem Header="Paste command input" Click="PasteClicked"/>
                            <Separator/>
                            <MenuItem Header="Back-scroll..." Click="BackScrollClicked" InputGestureText="Alt+B"/>
                            <MenuItem Header="Capture / Export Log..." Click="ExportLogClicked"/>
                            <MenuItem Header="Clear Screen" Click="ClearClicked"/>
                            <Separator/>
                            <MenuItem Header="Show Item Weights" Click="ShowItemWeightsClicked"/>
                            <MenuItem Header="Reset Internals (@reset)" Click="ResetInternalsClicked" ToolTip="Resets local client caches; does not send @reset."/>
                            <MenuItem Header="Reset Window Positions" Click="ResetWindowPositionsClicked"/>
                            <MenuItem Header="Reset ANSI" Click="ResetAnsiClicked"/>
                            <MenuItem Header="Reset custom profile" Click="ResetCustomProfileClicked"/>
                            <Separator/>
                            <MenuItem Header="Record path" Click="RecordPathClicked"/>
                            <MenuItem Header="Import" Click="ImportPathClicked"/>
                            <MenuItem Header="Fix path steps" Click="FixPathStepsClicked"/>
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Conversations" Click="ConversationsClicked"/>
                            <MenuItem Header="Online players" Click="OnlinePlayersClicked"/>
                            <MenuItem Header="Live Map" Click="LiveMapClicked" InputGestureText="Alt+T"/>
                            <Separator/>
                            <MenuItem Header="Player statistics" Click="PlayerStatisticsClicked"/>
                            <MenuItem Header="Session statistics" Click="SessionStatisticsClicked"/>
                            <MenuItem Header="Time Analysis" Click="TimeAnalysisClicked"/>
                            <MenuItem Header="Exp. Rate Graph" Click="ExperienceRateGraphClicked"/>
                            <Separator/>
                            <MenuItem Header="Party status" Click="PartyStatusClicked"/>
                            <MenuItem Header="Quick Tools" Click="QuickToolsClicked"/>
                        </MenuItem>
                        <MenuItem Header="_Action">
                            <MenuItem Header="Goto..." Click="GotoClicked" InputGestureText="Alt+G" ToolTip="Browse decoded and imported routes. Execution remains governed by automation safety controls."/>
                            <MenuItem Header="Loop..." Click="LoopClicked" InputGestureText="Alt+L" ToolTip="Browse decoded loop routes. Execution remains governed by automation safety controls."/>
                            <MenuItem Header="Auto-Roam..." Click="AutoRoamClicked" InputGestureText="Alt+R" ToolTip="Repeat a decoded loop with exact room confirmation and safety controls."/>
                            <MenuItem Header="Back Track" Click="BackTrackClicked" ToolTip="Reverse the last room-confirmed standard-direction route. Special exits fail closed."/>
                            <MenuItem Header="Stop" Click="StopAllClicked" ToolTip="Stops and pauses all client automation state."/>
                            <Separator/>
                            <MenuItem Header="Get All" Click="GetAllClicked"/>
                            <MenuItem Header="Drop All" Click="DropAllClicked"/>
                            <MenuItem Header="Equip All" Click="EquipAllClicked"/>
                            <MenuItem Header="Deposit All" Click="DepositAllClicked"/>
                            <Separator/>
                            <MenuItem Header="All Auto-Responses Off" Click="StopAllClicked"/>
                            <MenuItem x:Name="AutoCombatMenu" Header="Auto Combat" IsCheckable="True" Tag="combat" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoPreAttackMenu" Header="Auto Pre-Attack" IsCheckable="True" Tag="preattack" Click="QuickAutomationClicked" ToolTip="Runs the configured pre-attack command once before engaging a decoded hostile NPC."/>
                            <MenuItem x:Name="AutoNukeMenu" Header="Auto Nuke" IsCheckable="True" Tag="nuke" Click="QuickAutomationClicked" ToolTip="Uses configured spell priorities against decoded hostile NPCs while preserving the mana reserve."/>
                            <MenuItem x:Name="AutoRestHealMenu" Header="Auto Rest / Heal" IsCheckable="True" Tag="restheal" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoBlessMenu" Header="Auto Bless" IsCheckable="True" Tag="bless" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoLightMenu" Header="Auto Light" IsCheckable="True" Tag="light" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoGetItemsMenu" Header="Auto Get Items" IsCheckable="True" Tag="getitems" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoGetCashMenu" Header="Auto Get Cash" IsCheckable="True" Tag="getcash" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoSneakMenu" Header="Auto Sneak" IsCheckable="True" Tag="sneak" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoHideMenu" Header="Auto Hide" IsCheckable="True" Tag="hide" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoSearchMenu" Header="Auto Search" IsCheckable="True" Tag="search" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AutoTrackMenu" Header="Auto Track" IsCheckable="True" Tag="track" Click="QuickAutomationClicked"/>
                        </MenuItem>
                        <MenuItem Header="_Options">
                            <MenuItem Header="Settings..." Click="OptionsClicked"/>
                            <MenuItem Header="Automation controls..." Click="AutomationControlsClicked" ToolTip="Configure independent client automation safety switches. Emergency Stop overrides every automatic command."/>
                            <MenuItem Header="Combat configuration..." Click="CombatOptionsClicked" InputGestureText="Alt+M" ToolTip="Configure verified combat actions and safety thresholds."/>
                            <MenuItem Header="Party configuration..." Click="PartyOptionsClicked" InputGestureText="Alt+P" ToolTip="Configure party following, assisting, healing, and recovery."/>
                            <MenuItem Header="Health configuration..." Click="HealthOptionsClicked" ToolTip="Configure healing, rest, meditation, cures, and emergency actions."/>
                            <Separator/>
                            <MenuItem Header="Game Data..." Click="GameDataClicked"/>
                            <MenuItem Header="Librarium Reference..." Click="LibrariumReferenceClicked"/>
                            <MenuItem Header="Events..." Click="EventsClicked"/>
                            <MenuItem x:Name="EventsEnabledMenu" Header="Events Enabled" IsCheckable="True" Tag="events" Click="QuickAutomationClicked"/>
                            <MenuItem x:Name="AwayFromKeyboardMenu" Header="Away From Keyboard..." IsCheckable="True" Click="AwayFromKeyboardClicked"/>
                            <Separator/>
                            <MenuItem Header="Font..." Click="FontClicked"/>
                            <MenuItem Header="Sound" Click="SoundClicked"/>
                            <Separator/>
                            <MenuItem Header="CP/Exp. Calculator..." Click="CharacterProgressCalculatorClicked"/>
                            <MenuItem Header="Inventory Calculator..." Click="InventoryCalculatorClicked"/>
                            <MenuItem Header="Spell Book..." Click="SpellBookClicked"/>
                            <MenuItem Header="Who Is Home?" Click="WhoIsHomeClicked"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="Reforged Help Center..." Click="HelpCenterClicked" InputGestureText="F1"/>
                            <MenuItem Header="Reforged client status..." Click="ClientStatusClicked"/>
                            <MenuItem Header="Keyboard and input help..." Click="KeyboardHelpClicked"/>
                            <Separator/>
                            <MenuItem Header="About Reforged Client..." Click="AboutClicked"/>
                        </MenuItem>
                    </Menu>
                </DockPanel>

                <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0" IsLocked="True">
                    <ToolBar Background="#F0F0F0" Padding="1" Band="0" BandIndex="0">
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="▣" ToolTip="Connect" Click="ConnectClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⊠" ToolTip="Disconnect" Click="DisconnectClicked"/>
                        <Separator/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="➜" ToolTip="Browse Goto routes" Click="GotoClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="↻" ToolTip="Browse loop routes" Click="LoopClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="✣" ToolTip="Choose Auto-Roam loop" Click="AutoRoamClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⚔" ToolTip="Combat configuration" Click="CombatOptionsClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="♥" ToolTip="Health configuration" Click="HealthOptionsClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="✚" ToolTip="Toggle Auto Bless" Click="BlessToggleClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="☀" ToolTip="Toggle Auto Light" Click="LightToggleClicked"/>
                        <Separator/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="♟" ToolTip="Party configuration" Click="PartyOptionsClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⌕" ToolTip="Find in received scrollback" Click="FindClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⚙" ToolTip="Settings" Click="OptionsClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⊘" ToolTip="Stop All" Click="StopAllClicked"/>
                    </ToolBar>
                </ToolBarTray>

                <StatusBar DockPanel.Dock="Bottom" Height="23" Padding="2,0" Background="#F0F0F0" Foreground="#111111" TextElement.Foreground="#111111" DataContext="{Binding Session}">
                    <TextBlock Text="●" Foreground="#16A040"/><TextBlock Text="{Binding DisplayName}" MinWidth="110"/><Separator/>
                    <TextBlock Text="{Binding RouteStep}" MinWidth="28"/><Separator/><TextBlock Text="{Binding ConnectionMessage}" MinWidth="105" ToolTip="{Binding TelnetStatus}"/><TextBlock Text="{Binding TerminalSizeSummary}" Margin="8,0,0,0" ToolTip="{Binding TelnetStatus}"/><Separator/>
                    <TextBlock Text="{Binding RouteProgress}" MinWidth="235"/><Separator/>
                    <TextBlock Text="{Binding PvpRealmSummary}" Margin="4,0" ToolTip="{Binding PvpCombatSummary}"/><Separator/>
                    <TextBlock Text="{Binding VitalSummary}"/>
                </StatusBar>

                <Border Background="#02050A"
                        BorderBrush="#8A8A8A"
                        BorderThickness="2"
                        Margin="2,0,2,2"
                        ClipToBounds="True">
                    <views:ClassicMegaMudTerminal
                        x:Name="ClassicTerminalSurface"
                        Snapshot="{Binding Session.ClassicScreen}"
                        IsPasswordMode="False"
                        Background="#02050A"
                        Foreground="#FFFFFF"
                        FontFamily="Lucida Console"
                        FontSize="18"
                        CommandSubmitted="ClassicTerminalCommandSubmitted"
                        KeySubmitted="ClassicTerminalKeySubmitted"
                        TerminalSizeChanged="ClassicTerminalSizeChanged"/>
                </Border>
            </DockPanel>
            <!-- Retired pre-parity presentation kept collapsed until its remaining layout is removed mechanically. -->
            <DockPanel x:Name="ReforgedWorkspace" Visibility="Collapsed">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </DockPanel.Style>

                <Menu DockPanel.Dock="Top" Background="#20262C" Foreground="#F1F6FA">
                    <MenuItem Header="_Connection">
                        <MenuItem Header="_Connect" Click="ConnectClicked"/>
                        <MenuItem Header="_Disconnect" Click="DisconnectClicked"/>
                        <Separator/>
                        <MenuItem Header="_Close Terminal" Click="CloseClicked"/>
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Clear Screen" Click="ClearClicked"/>
                        <MenuItem Header="_Export Log" Click="ExportLogClicked"/>
                        <Separator/>
                        <MenuItem Header="_Options..." Click="OptionsClicked"/>
                    </MenuItem>
                    <MenuItem Header="_Automation">
                        <MenuItem Header="_Auto On/Off" Click="AutoToggleClicked"/>
                        <MenuItem Header="_Stop All" Click="StopAllClicked"/>
                    </MenuItem>
                </Menu>

                <StatusBar DockPanel.Dock="Bottom" Background="#173053" Foreground="#F1F6FA" TextElement.Foreground="#F1F6FA">
                    <TextBlock DataContext="{Binding Session}" Text="{Binding VitalSummary}"/>
                    <Separator/>
                    <TextBlock DataContext="{Binding Session}" Text="{Binding ConnectionMessage}"/>
                    <Separator/>
                    <TextBlock DataContext="{Binding Session}" Text="{Binding CurrentRoomName}"/>
                </StatusBar>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Padding="8" Background="#111417" BorderBrush="#2E3943" BorderThickness="0,0,0,1" DataContext="{Binding Session}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="HP:" Foreground="#8EE48E"/>
                                <TextBlock Text="{Binding HealthCurrent}" Foreground="#8EE48E" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="#8EE48E"/>
                                <TextBlock Text="{Binding HealthMaximum}" Foreground="#8EE48E" Margin="0,0,12,0"/>
                                <TextBlock Text="MA:" Foreground="#76C7FF"/>
                                <TextBlock Text="{Binding ManaCurrent}" Foreground="#76C7FF" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="#76C7FF"/>
                                <TextBlock Text="{Binding ManaMaximum}" Foreground="#76C7FF" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ConnectionState}" Foreground="#F6D36B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F1F6FA"/>
                        </DockPanel>
                    </Border>
                    <ListBox Grid.Row="1" DataContext="{Binding Session}" ItemsSource="{Binding TerminalLines}"
                             Background="#050608" Foreground="#E7EEF5" BorderThickness="0" FontFamily="Consolas" FontSize="16"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Foreground" Value="#E7EEF5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Row="2" Background="#050608">
                        <TextBlock Text=">" DockPanel.Dock="Left" Margin="10,7,6,7" FontFamily="Consolas" FontSize="17" Foreground="#C6F27A"/>
                        <Button Content="Send" DockPanel.Dock="Right" Margin="6" Padding="14,5" Click="SendClicked"/>
                        <TextBox x:Name="ClassicCommandInput" Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}" KeyDown="TerminalCommandKeyDown"
                                 Background="#050608" Foreground="#E7EEF5" BorderBrush="#2E3943" FontFamily="Consolas" FontSize="17"
                                 CaretBrush="#FFFFFF" Margin="0,5"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
