<Window x:Class="Reforged.App.Views.ClientTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Reforged.App.Views"
        Title="MegaMMUD Reforged"
        Width="1040"
        Height="760"
        MinWidth="760"
        MinHeight="500"
        Background="#F0F0F0"
        Foreground="#000000"
        FontFamily="Tahoma"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="ClassicToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#202020"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- The modern shell selector is hidden in Classic mode. Classic keeps a compact selector in its menu strip. -->
        <Border DockPanel.Dock="Top" Background="#151A1F" BorderBrush="#36414B" BorderThickness="0,0,0,1" Padding="8,5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLiveSession.TerminalViewMode}" Value="ClassicMegaMud">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Client view:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#C9D4DC"/>
                    <ComboBox Width="170" ItemsSource="{Binding TerminalViewModes}"
                              SelectedItem="{Binding SelectedLiveSession.TerminalViewMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="ViewModeSelectionChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Reforged"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="ClassicMegaMud"><Setter Property="Text" Value="Classic MegaMUD"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock DataContext="{Binding SelectedLiveSession}" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E7EEF5"/>
            </DockPanel>
        </Border>
        <Grid>
            <DockPanel x:Name="ClassicWorkspace" Background="#F0F0F0">
                <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedLiveSession.TerminalViewMode}" Value="ClassicMegaMud"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>

                <DockPanel DockPanel.Dock="Top" Background="#F0F0F0" LastChildFill="True">
                    <ComboBox DockPanel.Dock="Right" Width="128" Height="21" Margin="2,1,4,1"
                              ItemsSource="{Binding TerminalViewModes}"
                              SelectedItem="{Binding SelectedLiveSession.TerminalViewMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="ViewModeSelectionChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Reforged"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="ClassicMegaMud"><Setter Property="Text" Value="Classic MegaMUD"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Menu Background="#F0F0F0" Foreground="#111111" Padding="0">
                        <MenuItem Header="_File">
                            <MenuItem Header="New character..."/><MenuItem Header="Open character..."/><MenuItem Header="Save character"/><MenuItem Header="Save As..."/><Separator/>
                            <MenuItem Header="Disconnect" Click="DisconnectClicked"/><MenuItem Header="Hangup" Click="DisconnectClicked"/><MenuItem Header="Disable Hangup"/><Separator/>
                            <MenuItem Header="Upload..."/><MenuItem Header="Download..."/><Separator/><MenuItem Header="Exit" Click="CloseClicked"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="Copy" Click="CopyClicked"/><MenuItem Header="Paste" Click="PasteClicked"/><Separator/>
                            <MenuItem Header="Back-scroll..." Click="BackScrollClicked" InputGestureText="Alt+B"/><MenuItem Header="Capture..." Click="ExportLogClicked"/><MenuItem Header="Show Item Weights"/><Separator/>
                            <MenuItem Header="Reset Internals (@reset)"/><MenuItem Header="Reset Window Positions"/><MenuItem Header="Reset ANSI"/><MenuItem Header="Reset custom profile"/><Separator/>
                            <MenuItem Header="Record path"/><MenuItem Header="Import"/><MenuItem Header="Fix path steps"/>
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Conversations"/><MenuItem Header="Online players"/><MenuItem Header="Live Map: ALT-T (Alpha)"/><Separator/>
                            <MenuItem Header="Player statistics"/><MenuItem Header="Session statistics"/><MenuItem Header="Time Analysis"/><MenuItem Header="Exp. Rate Graph"/><Separator/>
                            <MenuItem Header="Party status"/><MenuItem Header="Quick Tools"/>
                        </MenuItem>
                        <MenuItem Header="_Action">
                            <MenuItem Header="Goto..." Click="GotoClicked" InputGestureText="Alt+G"/>
                            <MenuItem Header="Loop..." Click="LoopClicked" InputGestureText="Alt+L"/>
                            <MenuItem Header="Auto-Roam..." Click="LoopClicked" InputGestureText="Alt+R"/>
                            <MenuItem Header="Back Track"/><MenuItem Header="Stop" Click="StopAllClicked"/><Separator/>
                            <MenuItem Header="Get All"/><MenuItem Header="Drop All"/><MenuItem Header="Equip All"/><MenuItem Header="Deposit All"/><Separator/>
                            <MenuItem Header="All Auto-Responses Off" Click="StopAllClicked"/><MenuItem Header="Auto Combat" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Pre-Attack" IsCheckable="True" IsChecked="True"/>
                            <MenuItem Header="Auto Nuke" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Rest / Heal" IsCheckable="True" IsChecked="True" Click="HealthOptionsClicked"/><MenuItem Header="Auto Bless" IsCheckable="True" IsChecked="True"/>
                            <MenuItem Header="Auto Light" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Get Items" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Get Cash" IsCheckable="True" IsChecked="True"/>
                            <MenuItem Header="Auto Sneak" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Hide" IsCheckable="True" IsChecked="True"/><MenuItem Header="Auto Search" IsCheckable="True"/><MenuItem Header="Auto Track" IsCheckable="True"/>
                        </MenuItem>
                        <MenuItem Header="_Options">
                            <MenuItem Header="Settings..." Click="OptionsClicked"/><MenuItem Header="Game Data..." Click="OptionsClicked"/><MenuItem Header="Combat..." Click="CombatOptionsClicked" InputGestureText="Alt+M"/><MenuItem Header="Party..." Click="PartyOptionsClicked" InputGestureText="Alt+P"/><MenuItem Header="Health..." Click="HealthOptionsClicked"/>
                            <MenuItem Header="Events..." Click="OptionsClicked"/><MenuItem Header="Events Enabled" IsCheckable="True" IsChecked="True"/><MenuItem Header="Away From Keyboard"/><Separator/>
                            <MenuItem Header="Font..."/><MenuItem Header="Sound"/><Separator/><MenuItem Header="CP/Exp. Calculator..."/><MenuItem Header="Inventory Calculator..."/><MenuItem Header="Spell Book..."/><MenuItem Header="Who Is Home?"/>
                        </MenuItem>
                        <MenuItem Header="_Help"/>
                    </Menu>
                </DockPanel>

                <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0" IsLocked="True">
                    <ToolBar Background="#F0F0F0" Padding="1" Band="0" BandIndex="0">
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="▣" ToolTip="Connect" Click="ConnectClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⊠" ToolTip="Disconnect" Click="DisconnectClicked"/>
                        <Separator/><Button Style="{StaticResource ClassicToolbarButton}" Content="➜" ToolTip="Goto" Click="GotoClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="↻" ToolTip="Loop" Click="LoopClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="✣" ToolTip="Auto Roam" Click="LoopClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⚔" ToolTip="Combat" Click="CombatOptionsClicked"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="♥" ToolTip="Health / Rest / Heal" Click="HealthOptionsClicked"/><Button Style="{StaticResource ClassicToolbarButton}" Content="✚" ToolTip="Bless"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="☀" ToolTip="Light"/><Separator/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="♟" ToolTip="Party" Click="PartyOptionsClicked"/><Button Style="{StaticResource ClassicToolbarButton}" Content="⌕" ToolTip="Find"/>
                        <Button Style="{StaticResource ClassicToolbarButton}" Content="⚙" ToolTip="Settings" Click="OptionsClicked"/><Button Style="{StaticResource ClassicToolbarButton}" Content="⊘" ToolTip="Stop All" Click="StopAllClicked"/>
                    </ToolBar>
                </ToolBarTray>

                <StatusBar DockPanel.Dock="Bottom" Height="23" Padding="2,0" Background="#F0F0F0" Foreground="#111111" TextElement.Foreground="#111111" DataContext="{Binding SelectedLiveSession}">
                    <TextBlock Text="●" Foreground="#16A040"/><TextBlock Text="{Binding DisplayName}" MinWidth="110"/><Separator/>
                    <TextBlock Text="{Binding RouteStep}" MinWidth="28"/><Separator/><TextBlock Text="{Binding ConnectionMessage}" MinWidth="105"/><Separator/>
                    <TextBlock Text="{Binding RouteProgress}" MinWidth="235"/><Separator/><TextBlock Text="{Binding VitalSummary}"/>
                </StatusBar>

                <Border Background="#02050A" BorderBrush="#8A8A8A" BorderThickness="2" Margin="2,0,2,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ClassicTerminalLines"
                                 ItemsSource="{Binding SelectedLiveSession.TerminalLines}"
                                 Background="#02050A"
                                 Foreground="#E7E7E7"
                                 BorderThickness="0"
                                 FontFamily="Lucida Console"
                                 FontSize="18"
                                 Padding="5,3"
                                 HorizontalContentAlignment="Stretch"
                                 PreviewMouseWheel="ClassicTerminalMouseWheel"
                                 PreviewKeyDown="ClassicTerminalNavigationKeyDown"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="#E7E7E7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <views:AnsiTextBlock AnsiText="{Binding}"
                                                        TextWrapping="Wrap"
                                                        FontFamily="Lucida Console"
                                                        FontSize="18"
                                                        Foreground="#E7E7E7"
                                                        MaxWidth="{Binding ElementName=ClassicTerminalLines, Path=ActualWidth}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="1" Background="#02050A" Margin="5,1,3,1" Height="32" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedLiveSession.LivePromptText}"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     IsTabStop="False"
                                     Focusable="False"
                                     Background="#02050A"
                                     Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     FontFamily="Lucida Console"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     VerticalContentAlignment="Center"
                                     Height="32"
                                     Padding="0,1,0,1"
                                     Margin="0,0,0,0"/>

                            <Grid Grid.Column="1" MinWidth="260" VerticalAlignment="Stretch">
                                <TextBox x:Name="ClassicCommandInput"
                                         Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="TerminalCommandKeyDown"
                                         Background="#02050A"
                                         Foreground="#FFFFFF"
                                         SelectionBrush="#2B6CB0"
                                         Opacity="1"
                                         BorderThickness="0"
                                         FontFamily="Lucida Console"
                                         FontSize="18"
                                         FontWeight="Bold"
                                         CaretBrush="#FFFFFF"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Center"
                                         MinWidth="260"
                                         Height="32"
                                         Padding="0,1,0,1"/>
                                <PasswordBox x:Name="ClassicPasswordInput"
                                             Visibility="Collapsed"
                                             KeyDown="ClassicPasswordKeyDown"
                                             Background="#02050A"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             FontFamily="Lucida Console"
                                             FontSize="18"
                                             CaretBrush="#FFFFFF"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Center"
                                             MinWidth="260"
                                             Height="32"
                                             Padding="2,1,0,1"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>
            <!-- Existing modern Reforged terminal presentation. -->
            <DockPanel x:Name="ReforgedWorkspace">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedLiveSession.TerminalViewMode}" Value="Reforged">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Menu DockPanel.Dock="Top" Background="#20262C" Foreground="#F1F6FA">
                    <MenuItem Header="_Connection">
                        <MenuItem Header="_Connect" Click="ConnectClicked"/>
                        <MenuItem Header="_Disconnect" Click="DisconnectClicked"/>
                        <Separator/>
                        <MenuItem Header="_Close Terminal" Click="CloseClicked"/>
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Clear Screen" Click="ClearClicked"/>
                        <MenuItem Header="_Export Log" Click="ExportLogClicked"/>
                        <Separator/>
                        <MenuItem Header="_Options..." Click="OptionsClicked"/>
                    </MenuItem>
                    <MenuItem Header="_Automation">
                        <MenuItem Header="_Auto On/Off" Click="AutoToggleClicked"/>
                        <MenuItem Header="_Stop All" Click="StopAllClicked"/>
                    </MenuItem>
                </Menu>

                <StatusBar DockPanel.Dock="Bottom" Background="#173053" Foreground="#F1F6FA" TextElement.Foreground="#F1F6FA">
                    <TextBlock DataContext="{Binding SelectedLiveSession}" Text="{Binding VitalSummary}"/>
                    <Separator/>
                    <TextBlock DataContext="{Binding SelectedLiveSession}" Text="{Binding ConnectionMessage}"/>
                    <Separator/>
                    <TextBlock DataContext="{Binding SelectedLiveSession}" Text="{Binding CurrentRoomName}"/>
                </StatusBar>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Padding="8" Background="#111417" BorderBrush="#2E3943" BorderThickness="0,0,0,1" DataContext="{Binding SelectedLiveSession}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="HP:" Foreground="#8EE48E"/>
                                <TextBlock Text="{Binding HealthCurrent}" Foreground="#8EE48E" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="#8EE48E"/>
                                <TextBlock Text="{Binding HealthMaximum}" Foreground="#8EE48E" Margin="0,0,12,0"/>
                                <TextBlock Text="MA:" Foreground="#76C7FF"/>
                                <TextBlock Text="{Binding ManaCurrent}" Foreground="#76C7FF" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="#76C7FF"/>
                                <TextBlock Text="{Binding ManaMaximum}" Foreground="#76C7FF" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ConnectionState}" Foreground="#F6D36B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F1F6FA"/>
                        </DockPanel>
                    </Border>
                    <ListBox Grid.Row="1" DataContext="{Binding SelectedLiveSession}" ItemsSource="{Binding TerminalLines}"
                             Background="#050608" Foreground="#E7EEF5" BorderThickness="0" FontFamily="Consolas" FontSize="16"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Foreground" Value="#E7EEF5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Row="2" Background="#050608">
                        <TextBlock Text=">" DockPanel.Dock="Left" Margin="10,7,6,7" FontFamily="Consolas" FontSize="17" Foreground="#C6F27A"/>
                        <Button Content="Send" DockPanel.Dock="Right" Margin="6" Padding="14,5" Click="SendClicked"/>
                        <TextBox Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}" KeyDown="TerminalCommandKeyDown"
                                 Background="#050608" Foreground="#E7EEF5" BorderBrush="#2E3943" FontFamily="Consolas" FontSize="17"
                                 CaretBrush="#FFFFFF" Margin="0,5"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
