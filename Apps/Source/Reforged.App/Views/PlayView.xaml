<UserControl x:Class="Reforged.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="14" Margin="0,0,0,12" Background="#242A30" CornerRadius="5" TextElement.Foreground="#F1F6FA">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Character Profiles" Margin="4" Padding="14,7" Click="OpenCharacterProfilesClicked"/>
                    <Button Content="Options" Margin="4" Padding="14,7" Click="OpenOptionsClicked"/>
                    <Button Content="Diagnostics" Margin="4" Padding="14,7" Click="RefreshLibrariumSnapshotClicked"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MegaMUD-Style Client" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Select a server/session, then open a dedicated terminal window." Foreground="#C8D1DA" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Servers and Characters" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Add" Width="78" Margin="3" Click="AddSessionClicked"/>
                        <Button Content="Remove" Width="78" Margin="3" Click="RemoveSessionClicked"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding LiveSessions}" SelectedItem="{Binding SelectedLiveSession}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" BorderBrush="#B9AA91" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CharacterName}" Foreground="#5B4631"/>
                                        <TextBlock Text="{Binding StatusSummary}" FontSize="12" Foreground="#6C5A44"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Selected Server" Padding="12">
                <Grid DataContext="{Binding SelectedLiveSession}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Session name" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Text="Character" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Text="Server / BBS" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding ServerProfileName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Text="Host and port" VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3">
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Grid.Row="4" Text="World" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding WorldName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12" Padding="12" Background="{StaticResource ParchmentLightBrush}" TextElement.Foreground="{StaticResource ParchmentTextBrush}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionMessage}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentRoomName}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding VitalSummary}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding RouteProgress}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save Profile" Margin="4" Padding="18,8" Click="SaveConnectionProfileClicked"/>
                        <Button Content="Connect" Margin="4" Padding="18,8" Click="ConnectSessionClicked"/>
                        <Button Content="Open Terminal" Margin="4" Padding="18,8" Click="OpenTerminalClicked"/>
                        <Button Content="Disconnect" Margin="4" Padding="18,8" Click="DisconnectSessionClicked"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}"/>
        </StatusBar>
    </Grid>
</UserControl>
