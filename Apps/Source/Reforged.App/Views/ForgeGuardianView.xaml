<UserControl x:Class="Reforged.App.Views.ForgeGuardianView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <UserControl.Resources>
  <SolidColorBrush x:Key="ForgePanel" Color="#E60E1214"/>
  <SolidColorBrush x:Key="ForgePanel2" Color="#E6171C1F"/>
  <SolidColorBrush x:Key="ForgeBorder" Color="#76552F"/>
  <SolidColorBrush x:Key="ForgeGold" Color="#D5A75D"/>
  <SolidColorBrush x:Key="ForgeText" Color="#F1E5D0"/>
  <Style x:Key="ForgeButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
   <Setter Property="Background" Value="#242A2E"/>
   <Setter Property="BorderBrush" Value="{StaticResource ForgeBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Background" Value="#49311D"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Background" Value="#6B3E1D"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ForgeTextBox" TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
   <Setter Property="Background" Value="#111619"/>
   <Setter Property="BorderBrush" Value="#5A6870"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="CaretBrush" Value="#F2B24D"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource ForgeText}"/>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="#E4A84E"/>
   <Setter Property="Background" Value="#151B1E"/>
   <Setter Property="BorderBrush" Value="#4F4030"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Expander">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Margin="0,2">
       <DockPanel>
        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="#211A14" BorderThickness="0" Foreground="#E4A84E" Padding="9,7"
                      HorizontalContentAlignment="Left" Content="{TemplateBinding Header}" FontWeight="SemiBold"/>
        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
       </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>

 <Grid Background="#090C0E">
  <Grid.RowDefinitions>
   <RowDefinition Height="285"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="76"/>
  </Grid.RowDefinitions>

  <!-- Living Forge header -->
  <Border Grid.Row="0" Margin="8,8,8,6" BorderBrush="#8C6239" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
   <Grid>
    <Image Source="pack://application:,,,/Assets/Borin/BorinLivingForgeHeader.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle>
     <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="#DD090B0D" Offset="0"/>
       <GradientStop Color="#55090B0D" Offset="0.35"/>
       <GradientStop Color="#22090B0D" Offset="0.65"/>
       <GradientStop Color="#CC090B0D" Offset="1"/>
      </LinearGradientBrush>
     </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="24,18">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
     </Grid.ColumnDefinitions>

     <StackPanel Grid.Column="0">
      <TextBlock Text="THE FORGE" FontSize="15" FontWeight="Bold" Foreground="#E4A84E"/>
      <TextBlock Text="{Binding Configuration.CharacterName}" FontSize="34" FontWeight="Bold" Foreground="#F6D89A"/>
      <TextBlock Text="{Binding Configuration.CharacterTitle}" FontSize="16" FontStyle="Italic" Foreground="#D2B079"/>
      <Border Background="#B3151110" BorderBrush="#77552F" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,15,0,0">
       <StackPanel>
        <TextBlock Text="&#x201C;By fire, by code, an' by patient craft &#x2014; we build what legends do.&#x201D;"
                   TextWrapping="Wrap" FontStyle="Italic" FontSize="14"/>
        <TextBlock Text="{Binding Status}" Margin="0,10,0,0" Foreground="#F3B34F" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>

     <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
      <Border Background="#D7141110" BorderBrush="#A66E32" BorderThickness="1" CornerRadius="7" Padding="13">
       <StackPanel>
        <TextBlock Text="BORIN STATUS" FontWeight="Bold" Foreground="#E4A84E"/>
        <TextBlock Text="{Binding ModeSummary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <Separator Margin="0,9" Background="#5B4A36"/>
        <TextBlock Text="{Binding RepositorySummary}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding KnowledgeSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="#D7141110" BorderBrush="#76552F" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,10,0,0">
       <StackPanel>
        <TextBlock Text="CURRENT COMMISSION" FontWeight="Bold" Foreground="#E4A84E"/>
        <TextBlock Text="{Binding CurrentTask}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding TaskProgress, Mode=OneWay}" Margin="0,10,0,0"
                     Foreground="#62A84D" Background="#242A2E"/>
        <TextBlock Text="{Binding TaskStage}" HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0" Foreground="#C7B28E"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>

  <!-- Main workshop -->
  <Grid Grid.Row="1" Margin="8,0,8,6">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="210"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="390"/>
   </Grid.ColumnDefinitions>

   <!-- Library / project rail: compact dropdown sections -->
   <Border Grid.Column="0" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7" Padding="9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="LIBRARY &amp; PROJECT" FontSize="14" FontWeight="Bold" Foreground="#E4A84E" Margin="3,2,3,8"/>
      <Border Background="#151B1E" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
       <StackPanel>
        <TextBlock Text="ACTIVE REPOSITORY" FontWeight="Bold" Foreground="#BDA57F" FontSize="11"/>
        <TextBlock Text="{Binding Configuration.RepositoryPath}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"/>
       </StackPanel>
      </Border>

      <Expander Header="&#x1F4DA;  Repository" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <Button Content="Scan Repository" Command="{Binding ScanCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Open Solution" Command="{Binding OpenSolutionCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Inspect Tools" Command="{Binding ToolStatusCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F56F;  Study &amp; Research" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <Button Content="Study Host / Server" Command="{Binding StudyHostCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Study Entire Repository" Command="{Binding StudyRepositoryCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F4DC;  Attached Scrolls" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,7">
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,2,0,5">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Background="#1B2226" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,2">
            <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" FontSize="11"/>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Attach File" Command="{Binding AttachFileCommand}" Style="{StaticResource ForgeButton}"/>
        <Button Content="Clear Attachments" Command="{Binding ClearAttachmentsCommand}" Style="{StaticResource ForgeButton}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <!-- Conversation -->
   <Border Grid.Column="2" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" Background="#171D20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="CONVERSATION WITH BORIN" Margin="13,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4A84E"/>
      <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ForgeButton}" Padding="14,5" Margin="3,4,6,4"/>
     </Grid>

     <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" Background="#0B0F12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   CanContentScroll="False" PanningMode="VerticalOnly" Padding="8">
      <ItemsControl x:Name="ChatList" ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
         <Setter Property="HorizontalAlignment" Value="Stretch"/>
         <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
       </ItemsControl.ItemContainerStyle>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Background="#10161A" BorderBrush="#69767C" BorderThickness="1" CornerRadius="6" Padding="12"
                 HorizontalAlignment="Stretch">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#E4A84E"/>
           <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="#8D9A9F" FontSize="11"/>
           <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                    Margin="0,7,0,0" Foreground="#FFFFFFFF" Background="Transparent" BorderThickness="0"
                    Padding="0" FontSize="15" FontWeight="SemiBold" IsReadOnly="True" IsTabStop="False"
                    VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                    TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>

     <Border Grid.Row="2" Background="#111619" BorderBrush="#39454A" BorderThickness="1,1,1,0" Padding="8">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" MaxHeight="145"
                VerticalScrollBarVisibility="Auto" Style="{StaticResource ForgeTextBox}" FontSize="14"/>
       <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ForgeButton}" Padding="16,12"/>
       <Button Grid.Column="2" Content="SEND TO FORGE" Command="{Binding SendCommand}" Style="{StaticResource ForgeButton}"
               Background="#184E74" BorderBrush="#408FBD" Padding="18,12"/>
      </Grid>
     </Border>
    </Grid>
   </Border>

   <!-- Workbench: dropdown action groups -->
   <Border Grid.Column="4" Background="{StaticResource ForgePanel}" BorderBrush="{StaticResource ForgeBorder}" BorderThickness="1" CornerRadius="7" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="BORIN'S WORKBENCH" FontSize="14" FontWeight="Bold" Foreground="#E4A84E"/>
      <Border Background="#151B1E" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,7,0,8">
       <StackPanel>
        <TextBlock Text="CURRENT STATUS" FontWeight="Bold" Foreground="#BDA57F" FontSize="11"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#D6C3A6"/>
       </StackPanel>
      </Border>

      <Expander Header="&#x1F3AE;  Borin Active Player &amp; Parity Research" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding PlayerStatusSummary}" TextWrapping="Wrap" Margin="3,2,3,3" Foreground="#E4A84E" FontWeight="Bold"/>
        <TextBlock Text="{Binding PlayerSafetySummary}" TextWrapping="Wrap" Margin="3,0,3,3" Foreground="#AFC7B7"/>
        <TextBlock Text="{Binding PlayerStatusDetail}" TextWrapping="Wrap" Margin="3,0,3,7" Foreground="#9EAAA5" FontSize="10.5"/>

        <TextBlock Text="EXISTING BORIN SESSION &#x2014; SECURE LOGIN" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold" Margin="3,2,3,3"/>
        <TextBlock Text="{Binding PlayerLoginStatusSummary}" TextWrapping="Wrap" Foreground="#E4A84E" FontSize="10.5" FontWeight="Bold" Margin="3,0,3,2"/>
        <TextBlock Text="{Binding PlayerLoginStatusDetail}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="3,0,3,5"/>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerHostName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse BBS hostname" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse BBS port" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerLoginName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Omniverse User-ID" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerCharacterName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Borin MajorMUD character name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerSessionId, Mode=OneWay}" IsReadOnly="True" ToolTip="Existing Borin terminal session ID; this login pass does not create another session" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerServerProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server profile name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <Grid Margin="3,0,3,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding PlayerWorldName, UpdateSourceTrigger=PropertyChanged}" ToolTip="MajorMUD world name" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
         <TextBox Grid.Column="2" Text="{Binding PlayerPrimaryTeacher, UpdateSourceTrigger=PropertyChanged}" ToolTip="Primary human teacher" Style="{StaticResource ForgeTextBox}" MinHeight="28"/>
        </Grid>
        <TextBox Text="{Binding PlayerMentorAiName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Known AI mentor subject to the three-reply loop guard" Style="{StaticResource ForgeTextBox}" MinHeight="28" Margin="3,0,3,4"/>

        <TextBlock Text="SECURE PASSWORD" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,2,3,2"/>
        <PasswordBox x:Name="BorinPlayerPasswordBox" ToolTip="Saved only in Windows Credential Manager; never stored in Reforged files or sent to Qwen"
                     Foreground="{StaticResource ForgeText}" Background="#111619" BorderBrush="#5A6870" BorderThickness="1" Padding="9"
                     MinHeight="30" Margin="3,0,3,3" PasswordChar="*"/>
        <TextBlock Text="{Binding PlayerPasswordStatus}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10" Margin="3,0,3,3"/>
        <UniformGrid Columns="2" Margin="3,0,3,5">
         <Button Content="Save Password Securely" Click="SaveBorinPasswordClicked" Style="{StaticResource ForgeButton}"/>
         <Button Content="Clear Saved Password" Click="ClearBorinPasswordClicked" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>

        <WrapPanel Margin="3,1,3,5">
         <CheckBox Content="Enabled" IsChecked="{Binding PlayerEnabled, Mode=TwoWay}" Margin="0,0,12,4"/>
         <CheckBox Content="Safe combat allowed" IsChecked="{Binding PlayerAllowSafeCombat, Mode=TwoWay}" Margin="0,0,12,4"/>
         <CheckBox Content="Reflection journal" IsChecked="{Binding PlayerReflectionJournalEnabled, Mode=TwoWay}" Margin="0,0,12,4"/>
         <CheckBox Content="Auto reflection" IsChecked="{Binding PlayerAutomaticReflectionEnabled, Mode=TwoWay}" Margin="0,0,12,4"/>
         <CheckBox Content="Conversation learning" IsChecked="{Binding PlayerConversationLearningEnabled, Mode=TwoWay}" Margin="0,0,12,4"/>
        </WrapPanel>
        <TextBlock Text="Connect &amp; Login starts the connection and automatically enables Borin&apos;s Active Player profile. A disconnected state does not disable this action." TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10" Margin="3,0,3,4"/>
        <UniformGrid Columns="2">
         <Button Content="Save Profile" Command="{Binding SavePlayerProfileCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Connect &amp; Login" Command="{Binding ConnectPlayerCommand}" Style="{StaticResource ForgeButton}" ToolTip="Starts or resumes Borin&apos;s connection. Disconnected is the normal starting state."/>
         <Button Content="Open Borin Terminal" Click="OpenBorinTerminalClicked" Style="{StaticResource ForgeButton}"/>
         <Button Content="Disconnect" Command="{Binding DisconnectPlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Observe On / Off" Command="{Binding TogglePlayerObservationCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Conversation On / Off" Command="{Binding TogglePlayerConversationCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Journal On / Off" Command="{Binding TogglePlayerJournalCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Auto Reflection On / Off" Command="{Binding ToggleAutomaticReflectionCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Conversation Learning On / Off" Command="{Binding ToggleConversationLearningCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Player Help" Command="{Binding PlayerHelpCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>

        <Border Background="#111619" BorderBrush="#6A5B42" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,7,3,5">
         <StackPanel>
          <TextBlock Text="ASSIGNMENT &amp; AUTONOMOUS PLAY" Foreground="#D0B47D" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding PlayerEnvironmentSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10" Margin="0,2,0,2"/>
          <TextBlock Text="{Binding PlayerPerceptionSummary}" TextWrapping="Wrap" Foreground="#E0E6E2" FontSize="10" Margin="0,0,0,2"/>
          <TextBlock Text="{Binding PlayerAutonomousPlaySummary}" TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="0,0,0,5"/>
          <UniformGrid Columns="3">
           <Button Content="Assignment Window" Click="OpenBorinAssignmentClicked" Style="{StaticResource ForgeButton}"/>
           <Button Content="Play by Himself" Command="{Binding StartAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Stop Playing" Command="{Binding StopAutonomousPlayerCommand}" Style="{StaticResource ForgeButton}" Background="#651F1F" BorderBrush="#B54B4B"/>
          </UniformGrid>
          <TextBlock Text="Play by Himself remains locked until the exact active session has a fresh HP prompt, verified maximum HP, room title, and exit list. Human terminal input immediately returns control to William." TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>

        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,7,3,5">
         <StackPanel>
          <TextBlock Text="NEXT SUPERVISED ACTION" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding PlayerDecisionSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,5"/>
          <UniformGrid Columns="2">
           <Button Content="Ask Next Action" Command="{Binding ProposePlayerActionCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Approve Action" Command="{Binding ApprovePlayerActionCommand}" Style="{StaticResource ForgeButton}"/>
          </UniformGrid>
         </StackPanel>
        </Border>

        <TextBox Text="{Binding PlayerCommandInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="One supervised normal MajorMUD command" Style="{StaticResource ForgeTextBox}" MinHeight="30" Margin="3,0,3,3"/>
        <Button Content="Send Supervised Command" Command="{Binding SendSupervisedPlayerCommand}" Style="{StaticResource ForgeButton}" Margin="3,0,3,5"/>
        <UniformGrid Columns="3">
         <Button Content="Pause" Command="{Binding PausePlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Resume" Command="{Binding ResumePlayerCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopPlayerCommand}" Style="{StaticResource ForgeButton}" Background="#651F1F" BorderBrush="#B54B4B"/>
        </UniformGrid>

        <TextBlock Text="LAST CONVERSATION" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold" Margin="3,7,3,2"/>
        <TextBlock Text="{Binding PlayerLastConversationSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,4"/>

        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,6,3,5">
         <StackPanel>
          <TextBlock Text="BORIN'S PRIVATE REFLECTION &amp; CONVERSATION JOURNAL" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding PlayerReflectionJournalSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,4"/>
          <TextBlock Text="CURRENT REFLECTION" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold"/>
          <TextBox Text="{Binding PlayerCurrentReflection, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="150" Style="{StaticResource ForgeTextBox}" Margin="0,2,0,5"/>
          <TextBlock Text="REFLECTION FOCUS" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold"/>
          <TextBox Text="{Binding PlayerReflectionFocus, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="90" Style="{StaticResource ForgeTextBox}" Margin="0,2,0,4"/>
          <UniformGrid Columns="2">
           <Button Content="Write Reflection" Command="{Binding WritePlayerReflectionCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Show Journal Summary" Command="{Binding ShowPlayerJournalCommand}" Style="{StaticResource ForgeButton}"/>
          </UniformGrid>
          <TextBlock Text="LAST VERIFIED CONVERSATION LESSON" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="0,6,0,1"/>
          <TextBlock Text="{Binding PlayerConversationLessonSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5"/>
          <TextBlock Text="PLAYER PROFILE" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="0,5,0,1"/>
          <TextBlock Text="{Binding PlayerSpeakerProfileSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5"/>
          <TextBlock Text="WILLIAM'S REVIEW OF THE LAST DIRECT CONVERSATION" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="0,6,0,1"/>
          <TextBox Text="{Binding PlayerConversationReviewNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional reason or correction. This becomes a William-verified social lesson." TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="42" MaxHeight="82" Style="{StaticResource ForgeTextBox}" Margin="0,2,0,4"/>
          <UniformGrid Columns="3">
           <Button Content="Helpful" Command="{Binding MarkConversationHelpfulCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Awkward" Command="{Binding MarkConversationAwkwardCommand}" Style="{StaticResource ForgeButton}"/>
           <Button Content="Incorrect" Command="{Binding MarkConversationIncorrectCommand}" Style="{StaticResource ForgeButton}"/>
          </UniformGrid>
          <TextBlock Text="{Binding PlayerReflectionJournalPath}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="0,5,0,0"/>
          <TextBlock Text="Private journal entries are never broadcast in-game. They contain concise reflections and social lessons, not hidden chain-of-thought, credentials, or unreviewed player advice treated as fact." TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>

        <TextBlock Text="LAST PARITY EVIDENCE" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold" Margin="3,3,3,2"/>
