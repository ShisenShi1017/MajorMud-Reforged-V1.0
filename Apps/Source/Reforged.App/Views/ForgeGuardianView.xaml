                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,5,3,2"/>
        <TextBlock Text="Use /edit, /mark, and /complete to maintain evidence and archive completed tasks. Discussed and decided memories are never treated as proof that work was installed, built, or validated."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F50E;  Read-Only Reforged Access" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
