          <TextBlock Text="{Binding KnowledgeRecallSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,0"/>
         </StackPanel>
        </Border>
        <TextBlock Text="Use /learn reforged for the first resumable scan, /learn changed after repository updates, and /knowledge &lt;question&gt; for a direct indexed search. The Cancel button saves a checkpoint."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,6,3,2"/>
        <TextBlock Text="The index is stored under AI\Memory\Knowledge. It is retrieval, not Qwen retraining, and it never treats imported databases as authoritative gameplay data."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F393;  Borin Academy" IsExpanded="True" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding AcademyMajorMudMastery}" Foreground="#79C99E" FontWeight="Bold" Margin="3,2"/>
