                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F4DA;  Reforged Knowledge Index" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding KnowledgeIndexSummary}" TextWrapping="Wrap" Margin="3,2,3,7" Foreground="#AFC7B7"/>
        <TextBlock Text="{Binding MajorMudKnowledgeSummary}" TextWrapping="Wrap" Margin="3,0,3,7" Foreground="#79C99E"/>
