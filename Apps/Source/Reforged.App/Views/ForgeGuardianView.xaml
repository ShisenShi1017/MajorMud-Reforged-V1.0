         <Button Content="Run Mastery Test" Command="{Binding RunMasteryTestCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="View Conflicts" Command="{Binding ViewKnowledgeConflictsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="View Investigations" Command="{Binding ViewKnowledgeInvestigationsCommand}" Style="{StaticResource ForgeButton}"/>
