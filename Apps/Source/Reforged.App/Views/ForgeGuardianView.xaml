        <TextBlock Text="{Binding PlayerJournalPath}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="3,0,3,4"/>
        <TextBlock Text="Borin plays his own character through the exact active client session. Play by Himself uses only verified prompt, room, exit, command-ownership, and server evidence; it stops immediately when William types a terminal command or perception becomes stale."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,5,3,2"/>
        <TextBlock Text="MajorMUD Reforged is the application. Omniverse BBS, the Reforged server, and other configured BBS hosts remain distinct. Borin reports the connected server exactly and never invents an exit destination."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F3AF;  MajorMUD Mastery Curriculum" IsExpanded="False" Margin="0,2">
