        <TextBlock Text="Mastery is measured through five independent gates: explain, predict, perform live, retain after restart/context reset, and reject a false contradiction." TextWrapping="Wrap" Margin="3,0,3,6" Foreground="#AFC7B7" FontSize="10.5"/>
        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,0,3,5">
         <StackPanel>
          <TextBlock Text="NEXT TRAINING TARGET" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding MasteryNextLesson}" TextWrapping="Wrap" Foreground="#E0E6E2" FontSize="10.5" Margin="0,3,0,0"/>
         </StackPanel>
        </Border>
        <TextBlock Text="SKILL GRAPH" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,2,3,1"/>
        <TextBox Text="{Binding MasterySkillGraphSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="240" Style="{StaticResource ForgeTextBox}" Margin="3,0,3,5"/>
        <TextBlock Text="UNVERIFIED GAMEPLAY LESSON CANDIDATES" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,2,3,1"/>
        <TextBlock Text="{Binding MasteryCandidateSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,5"/>
        <TextBlock Text="WILLIAM-VERIFIED LESSONS" Foreground="#9EAAA5" FontSize="10" FontWeight="Bold" Margin="3,2,3,1"/>
        <TextBlock Text="{Binding MasteryVerifiedLessonSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="3,0,3,5"/>
        <UniformGrid Columns="2">
         <Button Content="Mastery Status" Command="{Binding MasteryStatusCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Skill Scores" Command="{Binding MasterySkillsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Next Lesson" Command="{Binding MasteryNextCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Lesson Candidates" Command="{Binding MasteryCandidatesCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Verified Lessons" Command="{Binding MasteryLessonsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Mastery Help" Command="{Binding MasteryHelpCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <TextBlock Text="{Binding MasteryStoragePath}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10" Margin="3,5,3,1"/>
        <TextBlock Text="Observed server results create candidates only. They become authoritative knowledge only after William verifies them. Server, world, character, command, and evidence paths remain attached to every compiled lesson." TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10" Margin="3,3,3,1"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F6E0;  Autonomous Engineering Job" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding EngineeringJobStage}" TextWrapping="Wrap" Margin="3,2,3,3" Foreground="#E4A84E" FontWeight="Bold"/>
        <TextBlock Text="{Binding EngineeringJobSummary}" TextWrapping="Wrap" Margin="3,0,3,5" Foreground="#AFC7B7"/>
        <TextBlock Text="{Binding EngineeringJobRequest}" TextWrapping="Wrap" Margin="3,0,3,5" Foreground="#D6C3A6"/>
        <TextBlock Text="{Binding EngineeringJobFiles}" TextWrapping="Wrap" Margin="3,0,3,5" Foreground="#9EAAA5" FontSize="10.5"/>
        <UniformGrid Columns="2">
         <Button Content="Start from Input" Command="{Binding StartEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Job Status" Command="{Binding ShowEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Proposed Changes" Command="{Binding ShowEngineeringChangesCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Recent Jobs" Command="{Binding ListEngineeringJobsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Apply Draft (Legacy)" Command="{Binding ApproveEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Reject Draft" Command="{Binding RejectEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Build &amp; Test" Command="{Binding BuildTestEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Correct Build" Command="{Binding CorrectEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Correction Attempts" Command="{Binding ShowCorrectionAttemptsCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Stop Correction" Command="{Binding StopEngineeringCorrectionCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Create Update ZIP" Command="{Binding PackageEngineeringJobCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Review &amp; Incorporate" Command="{Binding IncorporateEngineeringJobCommand}" Style="{StaticResource ForgeButton}" Background="#6A3518" BorderBrush="#D58A3A"/>
        </UniformGrid>
        <TextBlock Text="{Binding EngineeringCorrectionSummary}" TextWrapping="Wrap" Margin="3,6,3,2" Foreground="#D7B36A" FontSize="10.5"/>
        <TextBlock Text="Natural workflow: say Fix ...; Borin gathers evidence, patches only his isolated workspace, builds, tests, and corrects it automatically. Review &amp; Incorporate becomes available only after verification."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,7,3,2"/>
        <TextBlock Text="Build corrections are limited to three attempts and may touch only the drafted file set. Main-repository incorporation requires William's explicit confirmation, rejects conflicts with existing target-file changes, and never commits, pushes, publishes, installs, or deploys."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
        <TextBlock Text="{Binding EngineeringJobArtifact}" TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x2692;  Controlled Engineering Workspace" IsExpanded="False" Margin="0,2">
       <StackPanel Margin="5,4,0,8">
        <TextBlock Text="{Binding EngineeringWorkspaceSummary}" TextWrapping="Wrap" Margin="3,2,3,5" Foreground="#AFC7B7"/>
        <TextBlock Text="{Binding EngineeringWorkspacePath}" TextWrapping="Wrap" Margin="3,0,3,7" Foreground="#9EAAA5" FontSize="10.5"/>
        <UniformGrid Columns="2">
         <Button Content="Draft Input" Command="{Binding DraftEngineeringCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Engineering Help" Command="{Binding EngineeringHelpCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Create Snapshot" Command="{Binding CreateWorkspaceCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Status" Command="{Binding WorkspaceStatusCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Apply Draft" Command="{Binding ApplyProposedDiffCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Show Diff" Command="{Binding ShowDiffCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Build Snapshot" Command="{Binding BuildWorkspaceCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Test Snapshot" Command="{Binding TestWorkspaceCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Package Draft ZIP" Command="{Binding PackageEngineeringDraftCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Inspect Tools" Command="{Binding ToolStatusCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <TextBlock Text="Stage 6 keeps these lower-level workspace controls available beneath the approval-gated job orchestrator. It can draft a unified diff, apply it only to a private snapshot, build/test that snapshot, and create a reviewable update ZIP. It cannot apply to the main repository, install, commit, or push."
                   TextWrapping="Wrap" Foreground="#C7B28E" FontSize="10.5" Margin="3,7,3,2"/>
        <TextBlock Text="Type /draft &lt;request&gt; or use Draft Input. Then review the answer before using Apply Draft. Use /workspace recreate after the main repository changes."
                   TextWrapping="Wrap" Foreground="#9EAAA5" FontSize="10.5" Margin="3,2,3,2"/>
       </StackPanel>
      </Expander>

      <Expander Header="&#x1F5C3;  Borin's Memory" IsExpanded="False" Margin="0,2">
