         <Button Content="Memory Help" Command="{Binding MemoryHelpCommand}" Style="{StaticResource ForgeButton}"/>
        </UniformGrid>
        <Border Background="#111619" BorderBrush="#3E4A50" BorderThickness="1" CornerRadius="4" Padding="7" Margin="3,7,3,2">
         <StackPanel>
          <TextBlock Text="LAST RECALL" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding MemoryRecallSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,5"/>
          <TextBlock Text="REFORGED AWARENESS" Foreground="#BDA57F" FontSize="10.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding ProjectAwarenessSummary}" TextWrapping="Wrap" Foreground="#AFC7B7" FontSize="10.5" Margin="0,2,0,0"/>
         </StackPanel>
