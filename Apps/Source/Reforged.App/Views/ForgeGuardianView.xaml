        <UniformGrid Columns="2">
         <Button Content="Learn Reforged" Command="{Binding LearnReforgedCommand}" Style="{StaticResource ForgeButton}"/>
         <Button Content="Learn Changed" Command="{Binding LearnChangedCommand}" Style="{StaticResource ForgeButton}"/>
