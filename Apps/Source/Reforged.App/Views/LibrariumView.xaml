<UserControl x:Class="Reforged.App.Views.LibrariumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ShellBackground}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ParchmentPanelStyle}" Padding="14" Margin="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Librarium" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ParchmentTextBrush}"/>
          <TextBlock Text="{Binding Summary}" Margin="0,4,12,0" Foreground="{StaticResource ParchmentTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBox Grid.Column="1"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 MinHeight="34"
                 Margin="0,0,10,0"
                 ToolTip="Search the selected Librarium tab by name, ID, type, or record data"/>
        <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Margin="4"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Header, Mode=OneWay}"/>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <Grid Background="{StaticResource ParchmentLightBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding DataContext.ListHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                           Foreground="{StaticResource ParchmentTextBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding DataContext.FilteredRecords, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                         SelectedItem="{Binding DataContext.SelectedRecord, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         Background="{StaticResource ParchmentLightBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource ParchmentTextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8,8,14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ParchmentTextBrush}"
                                   TextWrapping="WrapWithOverflow"/>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Padding="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding DataContext.SelectedRecord.DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, TargetNullValue=Select a record}"
                             FontSize="22"
                             FontWeight="Bold"
                             Foreground="{StaticResource ParchmentTextBrush}"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding DataContext.SelectedRecord.Subheading, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                             Foreground="#5D4023"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding DataContext.SelectedRecord.Fields, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        Margin="0,8,0,0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Stat" Binding="{Binding Path=Path, Mode=OneWay}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="4"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Value" Binding="{Binding Path=Value, Mode=OneWay}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="4"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </Grid>
</UserControl>
