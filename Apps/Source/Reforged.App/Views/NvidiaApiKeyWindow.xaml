<Window x:Class="Reforged.App.Views.NvidiaApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borin NVIDIA NIM API Key" Width="520" Height="205"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#101518" Foreground="#F1E5D0">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Enter the NVIDIA NIM API key. It will be stored in Windows Credential Manager and will not be saved in Forge settings." TextWrapping="Wrap"/>
  <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Margin="0,14,0,0" Padding="9" Background="#080C0E" Foreground="White"/>
  <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="The existing key is never displayed again." Foreground="#BDA57F"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" Width="90" Margin="4" Padding="8" Click="Cancel_Click"/>
   <Button Content="Save Securely" Width="120" Margin="4" Padding="8" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
