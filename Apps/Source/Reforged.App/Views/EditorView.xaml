<UserControl x:Class="Reforged.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Classic Administration Editor" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Classic-only server controls. These settings do not modify imported MajorMUD source data."
                       TextWrapping="Wrap" Margin="0,4,0,12"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12">
            <GroupBox Header="Classic Item Limits" Margin="0,0,6,0">
                <StackPanel Margin="10">
                    <CheckBox Content="Unlimited items enabled"
                              IsChecked="{Binding UnlimitedItemsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsThreeState="False"
                              FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Turn this off to enforce each Classic item's decoded GameLimit when the server creates new items. Existing items are not deleted."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Global SYS GOTO" Margin="6,0,0,0">
                <StackPanel Margin="10">
                    <CheckBox Content="Allow every logged-in character to use SYSOP GOTO"
                              IsChecked="{Binding EveryoneCanUseSysGoto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsThreeState="False"
                              FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="This grants only the GOTO feature. It does not grant other SYSOP commands or administration authority."/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>

        <GroupBox Grid.Row="2" Header="Character SYSOP Key Access">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Select the Classic characters that should receive full SYSOP command access. Runtime saves, legacy saves, and active server sessions are all discovered."
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Characters}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="SYSOP Access" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding HasSysopAccess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" IsReadOnly="True" Width="1.3*"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding AccountId}" IsReadOnly="True" Width="1.1*"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="1.1*"/>
                        <DataGridTextColumn Header="Character ID" Binding="{Binding CharacterId}" IsReadOnly="True" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProjectRoot, StringFormat='Repository: {0}'}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PolicyPath, StringFormat='Settings file: {0}'}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="16,7" Margin="0,0,8,0"/>
                <Button Content="Save Classic Settings" Command="{Binding SaveCommand}" Padding="16,7"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
