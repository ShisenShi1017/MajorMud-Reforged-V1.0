<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>RealmGate.App.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RealmGate</AssemblyName>
    <RootNamespace>RealmGate.App</RootNamespace>
    <AssemblyTitle>RealmGate</AssemblyTitle>
    <Product>RealmGate</Product>
    <Company>RealmGate</Company>
    <Authors>RealmGate contributors</Authors>
    <Description Condition="'$(PublicRelease)' != 'true'">RealmGate game host, client, Creator Studio, Librarium, and Borin.</Description>
    <Description Condition="'$(PublicRelease)' == 'true'">RealmGate game host, client, Creator Studio, and Librarium.</Description>
    <Copyright>Copyright (c) 2026 RealmGate contributors</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Branding\RealmGate.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\Release\RealmGate\</PublishDir>
    <PublicRelease Condition="'$(PublicRelease)' == ''">false</PublicRelease>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublicRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);PUBLIC_RELEASE</DefineConstants>
  </PropertyGroup>

  <!-- Release builds and publishes always land in the repo-level release application folder. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\Release\RealmGate\</OutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\Release\RealmGate\</PublishDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RealmGate.Server.Runtime/RealmGate.Server.Runtime.csproj" />
    <ProjectReference Include="../../Compiler/RealmGate.Compiler.csproj" />
  </ItemGroup>

  <!-- Keep the high-resolution icon master beside the embedded multi-resolution ICO. -->
  <ItemGroup>
    <None Update="Assets\Branding\RealmGateIcon.png" />
  </ItemGroup>

  <!-- Pure-managed MDB/ACCDB reader used only to compare an external BBS database
       against the immutable Classic base and generate a small local overlay. -->
  <ItemGroup>
    <PackageReference Include="JackcessDotNet" Version="1.2.2" />
  </ItemGroup>

  <!-- Bundled Classic navigation graph used by Goto/Auto-Roam in clean builds. -->
  <ItemGroup>
    <Content Include="Assets\Paths\classic_route_graph.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Private/development-only AI dependencies. Public releases do not restore them. -->
  <ItemGroup Condition="'$(PublicRelease)' != 'true'">
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Normal development build: keep Borin and exclude the alternate public composition. -->
  <ItemGroup Condition="'$(PublicRelease)' != 'true'">
    <Compile Remove="App.PublicRelease.cs" />
    <Page Remove="MainWindow.PublicRelease.xaml" />
    <Resource Include="Assets\Borin\BorinIronbeard.png" />
    <Resource Include="Assets\Borin\BorinLivingForgeHeader.png" />
  </ItemGroup>

  <!-- Public build: swap composition roots and fail closed around all private Borin surfaces. -->
  <ItemGroup Condition="'$(PublicRelease)' == 'true'">
    <Compile Remove="App.xaml.cs" />
    <Page Remove="MainWindow.xaml" />

    <Compile Remove="Brains\**\*.cs" />
    <Compile Remove="BorinCapabilities\**\*.cs" />
    <Compile Remove="Forge\**\*.cs" />
    <Compile Remove="Engineering\**\*.cs" />
    <Compile Remove="ViewModels\BorinForgeViewModel.cs" />
    <Compile Remove="Views\Borin*.xaml.cs" />
    <Compile Remove="Views\NvidiaApiKeyWindow.xaml.cs" />

    <Page Remove="Views\Borin*.xaml" />
    <Page Remove="Views\NvidiaApiKeyWindow.xaml" />
    <Resource Remove="Assets\Borin\**\*" />
  </ItemGroup>

  <Target Name="PrunePublishedReleaseExtras" AfterTargets="Publish">
    <ItemGroup>
      <ReleaseExtras Include="$(PublishDir)runtimes\linux-x64\**\*" />
      <ReleaseExtras Include="$(PublishDir)**\*.pdb" />
      <ReleaseExtras Include="$(PublishDir)cs\**\*" />
      <ReleaseExtras Include="$(PublishDir)de\**\*" />
      <ReleaseExtras Include="$(PublishDir)es\**\*" />
      <ReleaseExtras Include="$(PublishDir)fr\**\*" />
      <ReleaseExtras Include="$(PublishDir)it\**\*" />
      <ReleaseExtras Include="$(PublishDir)ja\**\*" />
      <ReleaseExtras Include="$(PublishDir)ko\**\*" />
      <ReleaseExtras Include="$(PublishDir)pl\**\*" />
      <ReleaseExtras Include="$(PublishDir)pt-BR\**\*" />
      <ReleaseExtras Include="$(PublishDir)ru\**\*" />
      <ReleaseExtras Include="$(PublishDir)tr\**\*" />
      <ReleaseExtras Include="$(PublishDir)zh-Hans\**\*" />
      <ReleaseExtras Include="$(PublishDir)zh-Hant\**\*" />
    </ItemGroup>
    <Delete Files="@(ReleaseExtras)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)runtimes\linux-x64;$(PublishDir)cs;$(PublishDir)de;$(PublishDir)es;$(PublishDir)fr;$(PublishDir)it;$(PublishDir)ja;$(PublishDir)ko;$(PublishDir)pl;$(PublishDir)pt-BR;$(PublishDir)ru;$(PublishDir)tr;$(PublishDir)zh-Hans;$(PublishDir)zh-Hant" />
  </Target>
</Project>