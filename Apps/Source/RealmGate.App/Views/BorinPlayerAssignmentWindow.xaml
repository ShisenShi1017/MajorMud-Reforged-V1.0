<Window x:Class="RealmGate.App.Views.BorinPlayerAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borin Assignment"
        Width="650" Height="520"
        MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="#0D1114"
        Foreground="#E0E6E2">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3E7CF"/>
            <Setter Property="Background" Value="#29343A"/>
            <Setter Property="BorderBrush" Value="#6A5B42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E0E6E2"/>
            <Setter Property="Background" Value="#111619"/>
            <Setter Property="BorderBrush" Value="#5A6870"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BORIN'S CURRENT GAME ENVIRONMENT"
                   Foreground="#D0B47D" FontSize="13" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="#111619" BorderBrush="#3E4A50" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,6,0,8">
            <StackPanel>
                <TextBlock Text="{Binding PlayerEnvironmentSummary}" TextWrapping="Wrap" FontWeight="Bold"/>
                <TextBlock Text="{Binding PlayerPerceptionSummary}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#AFC7B7"/>
                <TextBlock Text="{Binding PlayerLastIncomingTelepath}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#9EAAA5"/>
                <TextBlock Text="{Binding PlayerAutonomousPlaySummary}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#C7B28E"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="ASSIGNMENT" Foreground="#D0B47D" FontSize="12" FontWeight="Bold"/>
        <TextBox Grid.Row="3"
                 Text="{Binding PlayerCurrentGoal, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,6,0,8"
                 ToolTip="Describe what Borin should accomplish while playing his current character."/>

        <UniformGrid Grid.Row="4" Columns="3">
            <Button Content="Save Assignment" Command="{Binding SavePlayerAssignmentCommand}"/>
            <Button Content="Play by Himself" Command="{Binding StartAutonomousPlayerCommand}" Background="#334C39" BorderBrush="#6D9675"/>
            <Button Content="Stop Playing" Command="{Binding StopAutonomousPlayerCommand}" Background="#651F1F" BorderBrush="#B54B4B"/>
        </UniformGrid>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" TextWrapping="Wrap" Foreground="#9EAAA5" MaxWidth="500"
                       Text="Autonomous play is allowed only after the exact terminal session proves a fresh HP prompt, verified maximum HP, room title, and exits. Borin may move only through a currently visible exit. Typing a command yourself stops him immediately."/>
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseClicked" MinWidth="90"/>
        </DockPanel>
    </Grid>
</Window>
