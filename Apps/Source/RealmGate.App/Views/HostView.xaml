<UserControl x:Class="RealmGate.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RealmGate.App.Views">
    <TabControl Margin="12">
        <TabItem Header="HOST CONTROL">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <WrapPanel>
                        <Button Content="Start Host" Command="{Binding StartCommand}"/>
                        <Button Content="Stop Host" Command="{Binding StopCommand}"/>
                        <Button Content="Restart Host" Command="{Binding RestartCommand}"/>
                    </WrapPanel>
                    <UniformGrid Columns="2">
                        <GroupBox Header="Server Access">
                            <StackPanel>
                                <TextBlock Text="Choose how RealmGate accepts connections." TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,6,0,6">
                                    <Button Content="Local Only" Command="{Binding UseLocalOnlyCommand}"/>
                                    <Button Content="LAN / Remote Hosting" Command="{Binding UseRemoteHostingCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="Bind address"/>
                                <TextBox Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="127.0.0.1 = local only   |   0.0.0.0 = all IPv4 interfaces" TextWrapping="Wrap" FontSize="11"/>
                                <TextBlock Text="Port"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding LanAddresses}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Router port forwarding, UPnP, and firewall rules are not changed automatically." TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                                <TextBlock Text="Maximum sessions"/><TextBox Text="{Binding MaximumSessions}"/>
                                <TextBlock Text="Default world"/><TextBox Text="{Binding SelectedWorld}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Live Status">
                            <StackPanel>
                                <TextBlock Text="{Binding State}" FontSize="22"/>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ConnectedSessions, StringFormat=Connected sessions: {0}}"/>
                                <TextBlock Text="Gameplay, networking, scheduler, and world simulation are Host-authoritative." TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </UniformGrid>
                    <GroupBox Header="Automatic Server Cleanup / Reset">
                        <StackPanel>
                            <CheckBox Content="Enable automatic cleanup/reset" IsChecked="{Binding Cleanup.Enabled}"/>
                            <TextBlock Text="Cleanup time (24-hour HH:mm)"/><TextBox Text="{Binding Cleanup.CleanupTime}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Time zone ID"/><TextBox Text="{Binding Cleanup.TimeZoneId}"/>
                            <CheckBox Content="Save before cleanup when supported by runtime" IsChecked="{Binding Cleanup.SaveBeforeCleanup}"/>
                            <CheckBox Content="Restart Host after cleanup" IsChecked="{Binding Cleanup.RestartHostAfterCleanup}"/>
                            <TextBlock Text="Player disconnect/warning message"/><TextBox Text="{Binding Cleanup.DisconnectMessage}"/>
                            <TextBlock Text="{Binding CleanupState}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NextCleanup, StringFormat=Next scheduled cleanup: {0:ddd MMM d, h:mm tt}}"/>
                            <WrapPanel>
                                <Button Content="Save Cleanup Schedule" Command="{Binding SaveCleanupCommand}"/>
                                <Button Content="Run Cleanup Now" Command="{Binding RunCleanupNowCommand}"/>
                                <Button Content="Postpone 30 Minutes" Command="{Binding PostponeCleanupCommand}"/>
                                <Button Content="Disable Schedule" Command="{Binding CancelCleanupCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="SESSIONS"><views:ServerView DataContext="{Binding Server}"/></TabItem>
        <TabItem Header="LOGS">
            <Grid Margin="10">
                <TextBox Text="{Binding RecentLogs, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
