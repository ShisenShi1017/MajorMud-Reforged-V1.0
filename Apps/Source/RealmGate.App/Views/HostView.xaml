<UserControl x:Class="RealmGate.App.Views.HostView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="18"><WrapPanel><Button Content="Start Host" Command="{Binding StartCommand}"/><Button Content="Stop Host" Command="{Binding StopCommand}"/><Button Content="Restart Host" Command="{Binding RestartCommand}"/></WrapPanel><UniformGrid Columns="2"><GroupBox Header="Host Configuration"><StackPanel><TextBlock Text="Bind address"/><TextBox Text="{Binding BindAddress}"/><TextBlock Text="Port"/><TextBox Text="{Binding Port}"/><TextBlock Text="Maximum sessions"/><TextBox Text="{Binding MaximumSessions}"/><TextBlock Text="Selected world"/><TextBox Text="{Binding SelectedWorld}"/></StackPanel></GroupBox><GroupBox Header="Live Status"><StackPanel><TextBlock Text="{Binding State}" FontSize="22"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding ConnectedSessions, StringFormat=Connected sessions: {0}}"/><TextBlock Text="Gameplay: authoritative runtime"/><TextBlock Text="Networking: runtime controlled"/><TextBlock Text="Scheduler: runtime controlled"/><TextBlock Text="World simulation: runtime controlled"/></StackPanel></GroupBox></UniformGrid><GroupBox Header="Automatic Server Cleanup / Reset"><StackPanel><CheckBox Content="Enable automatic cleanup/reset" IsChecked="{Binding Cleanup.Enabled}"/><TextBlock Text="Cleanup time (24-hour HH:mm)"/><TextBox Text="{Binding Cleanup.CleanupTime}" Width="120" HorizontalAlignment="Left"/><TextBlock Text="Time zone ID"/><TextBox Text="{Binding Cleanup.TimeZoneId}"/><CheckBox Content="Save before cleanup when supported by runtime" IsChecked="{Binding Cleanup.SaveBeforeCleanup}"/><CheckBox Content="Restart Host after cleanup" IsChecked="{Binding Cleanup.RestartHostAfterCleanup}"/><TextBlock Text="Player disconnect/warning message"/><TextBox Text="{Binding Cleanup.DisconnectMessage}"/><TextBlock Text="{Binding CleanupState}" FontWeight="Bold"/><TextBlock Text="{Binding NextCleanup, StringFormat=Next scheduled cleanup: {0:ddd MMM d, h:mm tt}}"/><WrapPanel><Button Content="Save Cleanup Schedule" Command="{Binding SaveCleanupCommand}"/><Button Content="Run Cleanup Now" Command="{Binding RunCleanupNowCommand}"/><Button Content="Postpone 30 Minutes" Command="{Binding PostponeCleanupCommand}"/><Button Content="Disable Schedule" Command="{Binding CancelCleanupCommand}"/></WrapPanel><TextBlock Text="Bundle 1 cleanup performs a graceful stop/restart of the verified Host. No generated world data is modified." TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="Recent Host Logs"><TextBox IsReadOnly="True" Height="220" Text="Host and cleanup logs are written to the user-data Logs folder."/></GroupBox></StackPanel></ScrollViewer></UserControl>