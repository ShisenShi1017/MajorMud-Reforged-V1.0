<UserControl x:Class="RealmGate.App.Views.ClientDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Client Readiness Diagnostics" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Checks the local Client workspace, six-session configuration, parsing profiles, terminal state, and route safety. Diagnostics never change Host or gameplay state." TextWrapping="Wrap" Margin="0,5,0,12"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource ParchmentLightBrush}" TextElement.Foreground="{StaticResource ParchmentTextBrush}" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Snapshot.Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Snapshot.LastRun, StringFormat=Last run: {0:G}}" Foreground="#496273" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Snapshot.Checks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="120"/>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="190"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Run Diagnostics" Click="RunDiagnosticsClicked" Padding="16,7" Margin="4"/>
                <Button Content="Export Report" Click="ExportDiagnosticsClicked" Padding="16,7" Margin="4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
