<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Global Reforged parchment-and-forged-metal palette -->
  <SolidColorBrush x:Key="ShellBackground" Color="#120E0A"/>
  <SolidColorBrush x:Key="PanelBackground" Color="#21170F"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#332316"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#4A321D"/>
  <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#6B3518"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#8A6338"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#E08A32"/>
  <SolidColorBrush x:Key="AccentGlowBrush" Color="#FFC565"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F7E7C4"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#C8AC7D"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1B120C"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#B94A3C"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#6F9C4B"/>
  <SolidColorBrush x:Key="ParchmentTextBrush" Color="#120A04"/>
  <SolidColorBrush x:Key="ParchmentMutedTextBrush" Color="#3E2816"/>

  <LinearGradientBrush x:Key="ForgedMetalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2B2118" Offset="0"/>
    <GradientStop Color="#15100C" Offset="0.5"/>
    <GradientStop Color="#302116" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ParchmentBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E5C891" Offset="0"/>
    <GradientStop Color="#CFAE72" Offset="0.48"/>
    <GradientStop Color="#B88B4A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ParchmentLightBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2DDAF" Offset="0"/>
    <GradientStop Color="#D6B87D" Offset="1"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="ForgeShadow" BlurRadius="12" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
  <DropShadowEffect x:Key="AmberGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="#FF8B28"/>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource ShellBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Georgia"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style TargetType="UserControl">
    <Setter Property="Background" Value="{StaticResource ShellBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Georgia"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style TargetType="Control"><Setter Property="FontSize" Value="14"/></Style>

  <Style x:Key="ForgePanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ForgedMetalBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Effect" Value="{StaticResource ForgeShadow}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="ParchmentPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
    <Setter Property="BorderBrush" Value="#6B431E"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Effect" Value="{StaticResource ForgeShadow}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource ForgedMetalBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="Georgia"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/><Setter Property="Effect" Value="{StaticResource AmberGlow}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource ForgedMetalBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="Georgia"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="MinHeight" Value="66"/>
    <Setter Property="Margin" Value="0,0,0,7"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#6B3518"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Foreground" Value="{StaticResource AccentGlowBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="NavLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/>
    <Setter Property="CaretBrush" Value="#2D1B0F"/>
    <Setter Property="BorderBrush" Value="#74502A"/>
    <Setter Property="SelectionBrush" Value="#D99842"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#2D1B0F"/>
    <Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/>
    <Setter Property="BorderBrush" Value="#74502A"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Margin" Value="5,8"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Margin" Value="5,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/><Setter Property="BorderBrush" Value="#74502A"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#38FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#58A75D20"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/></Style>
  <Style TargetType="TabControl"><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/><Setter Property="Background" Value="{StaticResource ParchmentBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/></Style>
  <Style TargetType="DataGrid">
    <Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource ParchmentLightBrush}"/>
    <Setter Property="RowBackground" Value="#F2DDAF"/>
    <Setter Property="AlternatingRowBackground" Value="#E7C98E"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#A5793B"/>
    <Setter Property="VerticalGridLinesBrush" Value="#A5793B"/>
    <Setter Property="BorderBrush" Value="#74502A"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="8,6"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource ParchmentTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource ParchmentTextBrush}"/>
  </Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource BorderBrush}"/><Setter Property="Margin" Value="0,12"/></Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <!-- Drop-down action menus used throughout the redesigned shell -->
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{StaticResource ForgedMetalBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontFamily" Value="Georgia"/>
  </Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource ForgedMetalBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
</ResourceDictionary>
