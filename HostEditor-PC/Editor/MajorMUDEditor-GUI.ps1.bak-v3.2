# MajorMUD Reforged Host Editor v2.7
# Simple Redux-style GUI editor for shared JSON game data.
# Edits the shared Data folder used by host/server, future PC client, and Android client.

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName Microsoft.VisualBasic

$ErrorActionPreference = 'Stop'
$Script:EditorDir = Split-Path -Parent $MyInvocation.MyCommand.Path
# Editor may live in HostEditor-PC or HostEditor-PC\Editor. Walk upward until the main Data folder is found.
$Script:Root = $Script:EditorDir
for($i=0; $i -lt 5; $i++){
  if(Test-Path (Join-Path $Script:Root 'Data')){ break }
  $parent = Split-Path -Parent $Script:Root
  if($parent -eq $Script:Root){ break }
  $Script:Root = $parent
}
$Script:DataDir = Join-Path $Script:Root 'Data'
$Script:BackupDir = Join-Path $Script:Root 'Backups'
$Script:CurrentCategory = $null
$Script:CurrentFile = $null
$Script:CurrentData = $null
$Script:CurrentItems = @()
$Script:CurrentIndex = -1
$Script:Dirty = $false

function Ensure-Dirs {
  foreach($d in @($Script:DataDir,$Script:BackupDir,(Join-Path $Script:Root 'Logs'))){
    if(!(Test-Path $d)){ New-Item -ItemType Directory -Force -Path $d | Out-Null }
  }
}

function Read-JsonFile($file){
  $path = Join-Path $Script:DataDir $file
  if(!(Test-Path $path)){ return $null }
  $raw = Get-Content $path -Raw
  if([string]::IsNullOrWhiteSpace($raw)){ return $null }
  return $raw | ConvertFrom-Json -Depth 100
}

function Save-JsonFile($file,$obj){
  $path = Join-Path $Script:DataDir $file
  $json = $obj | ConvertTo-Json -Depth 100
  Set-Content -Path $path -Value $json -Encoding UTF8
  $Script:Dirty = $false
}

function New-Backup {
  $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
  $dest = Join-Path $Script:BackupDir "Data-$stamp"
  New-Item -ItemType Directory -Force -Path $dest | Out-Null
  Copy-Item -Path (Join-Path $Script:DataDir '*') -Destination $dest -Recurse -Force
  [System.Windows.Forms.MessageBox]::Show("Backup created:`r`n$dest",'MajorMUD Editor') | Out-Null
}

function To-Hashtable($obj){
  if($null -eq $obj){ return $null }
  if($obj -is [System.Collections.IDictionary]){ return $obj }
  $ht = [ordered]@{}
  foreach($p in $obj.PSObject.Properties){ $ht[$p.Name] = $p.Value }
  return $ht
}

function Get-DisplayName($item){
  if($null -eq $item){ return '' }
  foreach($k in @('name','id','key','title')){
    $v = $item.PSObject.Properties[$k]
    if($v -and $v.Value){ return [string]$v.Value }
  }
  return '[unnamed]'
}

function Obj-Get($obj,$prop){
  if($null -eq $obj){ return $null }
  $p = $obj.PSObject.Properties[$prop]
  if($p){ return $p.Value }
  return $null
}

function Obj-Set($obj,$prop,$val){
  if($null -eq $obj){ return }
  $p = $obj.PSObject.Properties[$prop]
  if($p){ $obj.$prop = $val }
  else { Add-Member -InputObject $obj -NotePropertyName $prop -NotePropertyValue $val -Force }
}

function Format-Value($val){
  if($null -eq $val){ return '' }
  if($val -is [string]){ return $val }
  if($val -is [int] -or $val -is [long] -or $val -is [double] -or $val -is [decimal] -or $val -is [bool]){ return [string]$val }
  try { return ($val | ConvertTo-Json -Depth 50 -Compress) } catch { return [string]$val }
}

function Parse-Value($text){
  if($null -eq $text){ return '' }
  $t = [string]$text
  if($t.Trim() -eq ''){ return '' }
  if($t -match '^-?\d+$'){ return [int]$t }
  if($t -match '^-?\d+\.\d+$'){ return [double]$t }
  if($t -match '^(true|false)$'){ return [bool]::Parse($t) }
  if(($t.Trim().StartsWith('{') -and $t.Trim().EndsWith('}')) -or ($t.Trim().StartsWith('[') -and $t.Trim().EndsWith(']'))){
    try { return ($t | ConvertFrom-Json -Depth 100) } catch { return $t }
  }
  return $t
}

$Categories = @(
  [pscustomobject]@{Name='Rooms / World'; File='world.json'; Mode='rooms'},
  [pscustomobject]@{Name='Items'; File='items.json'; Mode='array'},
  [pscustomobject]@{Name='Monsters'; File='monsters.json'; Mode='array'},
  [pscustomobject]@{Name='Races'; File='races.json'; Mode='array'},
  [pscustomobject]@{Name='Classes'; File='classes.json'; Mode='array'},
  [pscustomobject]@{Name='Skills'; File='skills.json'; Mode='inner:skills'},
  [pscustomobject]@{Name='Spells'; File='spells.json'; Mode='inner:spells'},
  [pscustomobject]@{Name='Messages'; File='messages.json'; Mode='inner:messages'},
  [pscustomobject]@{Name='Leveling'; File='leveling.json'; Mode='root'},
  [pscustomobject]@{Name='Derived Stats'; File='derived_stats.json'; Mode='root'},
  [pscustomobject]@{Name='Progression'; File='progression.json'; Mode='root'}
