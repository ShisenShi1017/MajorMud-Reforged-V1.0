function Set-Status($msg){ $status.Text = $msg }

function Get-SelectedCategory {
  $idx = $catList.SelectedIndex
  if($idx -lt 0){ return $null }
  return $Categories[$idx]
}

function Load-Category($category){
  if($null -eq $category){ return }
  $Script:CurrentCategory = $category
  $Script:CurrentFile = $category.File
  $Script:CurrentData = Read-JsonFile $category.File
  $Script:CurrentItems = @()
  $Script:CurrentIndex = -1
  $itemList.Items.Clear()
  $grid.Rows.Clear()
  if($null -eq $Script:CurrentData){ Set-Status("Missing or empty $($category.File)"); return }

  switch -Regex ($category.Mode) {
    '^array$' { $Script:CurrentItems = @($Script:CurrentData) }
    '^rooms$' {
      $roomsObj = Obj-Get $Script:CurrentData 'rooms'
      $Script:CurrentItems = @()
      if($null -ne $roomsObj){
        foreach($p in $roomsObj.PSObject.Properties){
          $room = $p.Value
          Obj-Set $room 'id' $p.Name
          $Script:CurrentItems += $room
        }
      }
    }
    '^inner:(.+)$' {
      $prop = $Matches[1]
      $Script:CurrentItems = @(Obj-Get $Script:CurrentData $prop)
    }
    '^sections$' {
      foreach($p in $Script:CurrentData.PSObject.Properties){
        $obj = $p.Value
        if($null -ne $obj){ Obj-Set $obj 'id' $p.Name; Obj-Set $obj 'name' $p.Name; $Script:CurrentItems += $obj }
      }
    }
    '^root$' { $Script:CurrentItems = @($Script:CurrentData) }
  }
  Refresh-ItemList
  Set-Status("Loaded $($category.Name) from $($category.File)")
}

function Refresh-ItemList {
  $filter = $searchBox.Text.ToLower()
  $itemList.Items.Clear()
  for($i=0;$i -lt $Script:CurrentItems.Count;$i++){
    $name = Get-DisplayName $Script:CurrentItems[$i]
    $id = Obj-Get $Script:CurrentItems[$i] 'id'
    $display = if($id -and $id -ne $name){ "$name [$id]" } else { $name }
    if([string]::IsNullOrWhiteSpace($filter) -or $display.ToLower().Contains($filter)){
      [void]$itemList.Items.Add([pscustomobject]@{Index=$i;Text=$display})
    }
  }
  $itemList.DisplayMember = 'Text'
}

function Show-Item($index){
  $grid.Rows.Clear()
  $Script:CurrentIndex = $index
  if($index -lt 0 -or $index -ge $Script:CurrentItems.Count){ return }
  $item = $Script:CurrentItems[$index]
  foreach($p in $item.PSObject.Properties){
    $row = $grid.Rows.Add()
    $grid.Rows[$row].Cells[0].Value = $p.Name
    $grid.Rows[$row].Cells[1].Value = Format-Value $p.Value
  }
}

function Apply-Grid-To-Item {
  if($Script:CurrentIndex -lt 0 -or $Script:CurrentIndex -ge $Script:CurrentItems.Count){ return }
  $new = [pscustomobject]@{}
  foreach($row in $grid.Rows){
    if($row.IsNewRow){ continue }
    $field = [string]$row.Cells[0].Value
    if([string]::IsNullOrWhiteSpace($field)){ continue }
    $valText = [string]$row.Cells[1].Value
    Add-Member -InputObject $new -NotePropertyName $field.Trim() -NotePropertyValue (Parse-Value $valText) -Force
  }
  $Script:CurrentItems[$Script:CurrentIndex] = $new
  $Script:Dirty = $true
}

function Write-Back-Items {
  $cat = $Script:CurrentCategory
  if($null -eq $cat){ return }
  switch -Regex ($cat.Mode) {
    '^array$' { $Script:CurrentData = @($Script:CurrentItems) }
    '^rooms$' {
      $rooms = [ordered]@{}
      foreach($room in $Script:CurrentItems){
        $id = Obj-Get $room 'id'
        if([string]::IsNullOrWhiteSpace($id)){ $id = (Get-DisplayName $room).ToLower().Replace(' ','_') }
        $copy = $room | ConvertTo-Json -Depth 100 | ConvertFrom-Json -Depth 100
        if($copy.PSObject.Properties['id']){ $copy.PSObject.Properties.Remove('id') }
        $rooms[$id] = $copy
      }
      Obj-Set $Script:CurrentData 'rooms' ([pscustomobject]$rooms)
    }
    '^inner:(.+)$' {
      $prop = $Matches[1]
      Obj-Set $Script:CurrentData $prop @($Script:CurrentItems)
    }
    '^sections$' {
      $root = [pscustomobject]@{}
      foreach($section in $Script:CurrentItems){
        $id = Obj-Get $section 'id'
        if([string]::IsNullOrWhiteSpace($id)){ $id = Get-DisplayName $section }
        $copy = $section | ConvertTo-Json -Depth 100 | ConvertFrom-Json -Depth 100
        if($copy.PSObject.Properties['id']){ $copy.PSObject.Properties.Remove('id') }
        if($copy.PSObject.Properties['name']){ $copy.PSObject.Properties.Remove('name') }
        Add-Member -InputObject $root -NotePropertyName $id -NotePropertyValue $copy -Force
      }
      $Script:CurrentData = $root
    }
    '^root$' {
      if($Script:CurrentItems.Count -gt 0){ $Script:CurrentData = $Script:CurrentItems[0] }
    }
  }
}

function Save-Current {
  if($Script:CurrentIndex -ge 0){ Apply-Grid-To-Item }
  Write-Back-Items
  Save-JsonFile $Script:CurrentFile $Script:CurrentData
  Refresh-ItemList
  Set-Status("Saved $Script:CurrentFile")
}

function Add-NewItem {
  if($null -eq $Script:CurrentCategory){ return }
  if($Script:CurrentCategory.Mode -eq 'root'){
    [System.Windows.Forms.MessageBox]::Show('Root settings are edited directly; use rows on the right.','MajorMUD Editor') | Out-Null
    return
  }
  $id = [Microsoft.VisualBasic.Interaction]::InputBox('New ID / key:', 'Add New', 'new_entry')
  if([string]::IsNullOrWhiteSpace($id)){ return }
  $name = [Microsoft.VisualBasic.Interaction]::InputBox('Display name:', 'Add New', $id.Replace('_',' '))
  $obj = [pscustomobject]@{ id=$id; name=$name; description='New entry created in editor.' }
  if($Script:CurrentCategory.Mode -eq 'rooms'){
    $obj = [pscustomobject]@{ id=$id; name=$name; description='New room.'; exits=[pscustomobject]@{}; items=@(); monsters=@(); npcs=@() }
  }
  $Script:CurrentItems += $obj
  $Script:Dirty = $true
  Refresh-ItemList
  Set-Status("Added $name")
}

function Clone-Item {
  if($Script:CurrentIndex -lt 0){ return }
  $src = $Script:CurrentItems[$Script:CurrentIndex]
  $copy = $src | ConvertTo-Json -Depth 100 | ConvertFrom-Json -Depth 100
  $oldName = Get-DisplayName $copy
  Obj-Set $copy 'id' ((Obj-Get $copy 'id') + '_copy')
  Obj-Set $copy 'name' ($oldName + ' Copy')
  $Script:CurrentItems += $copy
  $Script:Dirty = $true
  Refresh-ItemList
  Set-Status("Cloned $oldName")
}

function Delete-Item {
  if($Script:CurrentIndex -lt 0){ return }
  $name = Get-DisplayName $Script:CurrentItems[$Script:CurrentIndex]
  $ans = [System.Windows.Forms.MessageBox]::Show("Delete '$name'?",'MajorMUD Editor','YesNo','Warning')
  if($ans -ne 'Yes'){ return }
  $new = @()
  for($i=0;$i -lt $Script:CurrentItems.Count;$i++){ if($i -ne $Script:CurrentIndex){ $new += $Script:CurrentItems[$i] } }
  $Script:CurrentItems = $new
  $Script:CurrentIndex = -1
  $Script:Dirty = $true
  Refresh-ItemList
  $grid.Rows.Clear()
  Set-Status("Deleted $name")
}

$catList.Add_SelectedIndexChanged({ Load-Category (Get-SelectedCategory) })
$itemList.Add_SelectedIndexChanged({
  if($Script:CurrentIndex -ge 0){ Apply-Grid-To-Item }
  $sel = $itemList.SelectedItem
  if($null -ne $sel){ Show-Item $sel.Index }
})
$searchBox.Add_TextChanged({ Refresh-ItemList })
$btnSave.Add_Click({ try { Save-Current } catch { [System.Windows.Forms.MessageBox]::Show($_.Exception.Message,'Save Error') | Out-Null } })
$btnBackup.Add_Click({ try { New-Backup } catch { [System.Windows.Forms.MessageBox]::Show($_.Exception.Message,'Backup Error') | Out-Null } })
$btnReload.Add_Click({ Load-Category (Get-SelectedCategory) })
$btnAdd.Add_Click({ Add-NewItem })
$btnClone.Add_Click({ Clone-Item })
$btnDelete.Add_Click({ Delete-Item })
$grid.Add_CellValueChanged({ $Script:Dirty = $true })
$form.Add_FormClosing({
  if($Script:Dirty){
    $ans = [System.Windows.Forms.MessageBox]::Show('You have unsaved changes. Save before closing?','MajorMUD Editor','YesNoCancel','Question')
    if($ans -eq 'Cancel'){ $_.Cancel = $true; return }
    if($ans -eq 'Yes'){ Save-Current }
  }
})

# load first category after form is ready
$catList.SelectedIndex = 0
[void]$form.ShowDialog()
