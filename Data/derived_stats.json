{
  "version": "1.9",
  "notes": "Derived/secondary stats are calculated from core stats plus race, class, and equipment bonuses. Tune this later to match legacy MUD data more closely.",
  "secondaryStats": [
    "stealth",
    "perception",
    "search",
    "dodge",
    "hitBonus",
    "damageBonus",
    "magic",
    "faith",
    "charm",
    "lockpick",
    "hide",
    "tracking",
    "parry",
    "critical"
  ],
  "formulas": {
    "stealth": "AGI*2 + INT/3 + race/class/equipment bonuses",
    "perception": "AGI + INT + WIL/2 + bonuses",
    "search": "INT + AGI/2 + WIL/2 + bonuses",
    "dodge": "AGI*2 + CON/3 + bonuses",
    "hitBonus": "AGI/2 + STR/3 + bonuses",
    "damageBonus": "(STR-10)/3 + bonuses",
    "magic": "INT*2 + WIL/2 + bonuses",
    "faith": "WIL*2 + CHA/2 + bonuses",
    "charm": "CHA*2 + WIL/3 + bonuses"
  }
}